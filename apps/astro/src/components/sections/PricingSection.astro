---
import { SEGMENT_LABELS, formatRupiah, waLink, WHATSAPP, type PricingCategory } from "@daydev/shared-types";
import { Bot, GraduationCap, Mail, Rocket, Store } from "lucide-react";

interface Props {
  categories: PricingCategory[];
}

const categoryIcons: Record<string, any> = {
  "undangan-digital": Mail,
  "bot-telegram": Bot,
  mahasiswa: GraduationCap,
  umkm: Store,
  startup: Rocket,
};

const { categories } = Astro.props;

const publishedCategories = categories
  .filter((c) => c.packages?.length)
  .sort((a, b) => a.display_order - b.display_order);
---

<section id="harga" class="bg-background py-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="mb-16 text-center">
      <span class="fade-in mb-4 inline-block rounded-full border border-[#b45309]/25 bg-[#b45309]/10 px-4 py-2 text-sm font-semibold text-[#b45309]"
        >Harga Transparan</span
      >
      <h2 class="fade-in text-3xl font-bold text-[#172033] sm:text-4xl lg:text-5xl">
        Investasi yang <span class="text-[#b45309]">Sepadan</span>
      </h2>
      <p class="fade-in mx-auto max-w-2xl text-lg text-slate-600">
        Semua paket sudah termasuk konsultasi gratis sebelum memulai. Tidak ada
        biaya tersembunyi.
      </p>
    </div>

    {
      publishedCategories.length === 0 ? (
        <p class="text-center text-muted-foreground">
          Daftar harga sedang diperbarui. Hubungi kami untuk penawaran sesuai
          kebutuhan.
        </p>
      ) : (
        <div class="space-y-16">
          {
            publishedCategories.map((category) => {
              const CategoryIcon =
                categoryIcons[category.segment] ?? Rocket;
              return (
                <div class="fade-in">
                  <div class="mb-8 flex items-center gap-4">
                    <div class="flex size-12 items-center justify-center rounded-xl bg-muted">
                      <CategoryIcon className="size-6 text-primary" aria-hidden="true" />
                    </div>
                    <div>
                      <div class="flex items-center gap-3">
                        <h3 class="text-2xl font-bold text-[#172033]">
                          {category.label}
                        </h3>
                        <span class="rounded-full bg-muted px-3 py-1 text-xs font-semibold text-primary">
                          {category.starting_price_label}
                        </span>
                      </div>
                      <p class="text-sm text-slate-600">
                        {SEGMENT_LABELS[category.segment]}
                      </p>
                    </div>
                  </div>

                  <div class="flex snap-x flex-row justify-start gap-6 overflow-x-auto pb-2">
                    {
                      category.packages.map((plan) => {
                        const recommended = plan.is_recommended;
                        return (
                          <div
                            class={`card-hover relative w-[300px] max-w-[340px] shrink-0 snap-start flex-1 overflow-hidden rounded-2xl border-2 ${
                              recommended ? "border-[#ea7b3c] shadow-xl" : "border-gray-100 shadow-sm"
                            }`}
                          >
                            {
                              recommended && (
                                <div class="bg-[#ea7b3c] py-1.5 text-center text-xs font-bold uppercase tracking-wider text-[#172033]">
                                  Rekomendasi
                                </div>
                              )
                            }
                            <div class={`p-6 ${recommended ? "bg-muted" : "bg-white"}`}>
                              <h4 class="mb-1 text-lg font-bold text-[#172033]">{plan.name}</h4>
                              <div class="mb-6 flex items-baseline gap-1">
                                <span class="text-3xl font-extrabold text-primary">
                                  {formatRupiah(plan.price)}
                                </span>
                              </div>
                              <ul class="mb-6 space-y-3">
                                {
                                  plan.features?.map((f) => (
                                    <li class="flex items-start gap-2.5 text-sm text-slate-600">
                                      <span class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-primary text-xs font-bold text-white" aria-hidden="true">
                                        ✓
                                      </span>
                                      {f}
                                    </li>
                                  ))
                                }
                              </ul>
                              <a
                                href={waLink(WHATSAPP.messagePlan(plan.name, category.label))}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={`flex min-h-[48px] w-full items-center justify-center rounded-xl px-4 py-3 text-center text-sm font-semibold transition-all duration-300 ${
                                  recommended
                                    ? "bg-primary text-white hover:brightness-110"
                                    : "border-2 border-primary text-primary hover:bg-primary hover:text-white"
                                }`}
                              >
                                Pesan via WhatsApp
                              </a>
                              {
                                plan.demo_url && (
                                  <a
                                    href={plan.demo_url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="mt-3 flex min-h-[44px] items-center justify-center text-sm text-slate-500 transition-colors hover:text-slate-700"
                                  >
                                    Buka Demo Live
                                  </a>
                                )
                              }
                            </div>
                          </div>
                        );
                      })
                    }
                  </div>
                </div>
              );
            })
          }
        </div>
      )
    }

    <div class="fade-in mt-16 rounded-2xl bg-[#172033] p-8 text-center text-white">
      <h3 class="mb-3 text-2xl font-bold">Butuh Solusi yang Lebih Spesifik?</h3>
      <p class="mb-6 text-gray-300">
        Kami juga menerima proyek custom dengan kebutuhan unik. Diskusikan
        kebutuhan Anda dan kami akan berikan penawaran terbaik!
      </p>
      <a
        href={waLink("Halo Daydev, saya ingin diskusi proyek custom.")}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-[52px] items-center gap-2 rounded-full bg-[#ea7b3c] px-8 py-3 font-bold text-[#172033] transition-all hover:brightness-110"
        >Chat WhatsApp Sekarang</a
      >
    </div>
  </div>
</section>