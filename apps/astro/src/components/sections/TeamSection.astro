---
import { waLink, type TeamMember } from "@daydev/shared-types";
import { ArrowUpRight } from "lucide-react";

interface Props {
  teams: TeamMember[];
}

const { teams } = Astro.props;

const published = teams
  .filter((t) => t.is_published)
  .sort((a, b) => a.display_order - b.display_order);
---

{
  published.length > 0 && (
    <section id="tim" class="section-space">
      <div class="site-container">
        <div class="mb-10 flex flex-wrap items-end justify-between gap-5">
          <h2 class="section-title">Tim Daydev</h2>
          <a href={waLink("Halo Daydev, saya ingin mengenal tim dan cara kerja kalian.")} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center font-semibold text-primary">Kenalan lewat WhatsApp</a>
        </div>

        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,19rem),1fr))] gap-8">
          {
            published.map((member) => (
              <div class="fade-in flex items-start gap-5">
                {
                  member.photo_url ? (
                    <img
                      src={member.photo_url}
                      alt={`Foto ${member.name}`}
                      loading="lazy"
                      width="80"
                      height="80"
                      class="size-20 shrink-0 rounded-2xl object-cover"
                    />
                  ) : (
                    <div class="flex size-20 shrink-0 items-center justify-center rounded-2xl bg-muted text-2xl font-bold text-foreground" aria-hidden="true">
                      {member.name.charAt(0).toUpperCase()}
                    </div>
                  )
                }
                <div class="min-w-0">
                <h3 class="text-xl font-semibold">{member.name}</h3>
                <p class="mt-1 leading-7 text-muted-foreground">{member.role}</p>
                {
                  member.linkedin_url && (
                    <a
                      href={member.linkedin_url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`LinkedIn ${member.name}`}
                      class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-semibold text-primary hover:underline"
                    >
                      LinkedIn <ArrowUpRight className="size-4" aria-hidden="true" />
                    </a>
                  )
                }
                </div>
              </div>
            ))
          }
        </div>

      </div>
    </section>
  )
}
