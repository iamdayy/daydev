---
import { Sun, Moon } from "lucide-react";
---

<button type="button" class="icon-button theme-toggle" data-theme-toggle aria-label="Aktifkan tema gelap" aria-pressed="false">
  <Sun className="theme-sun size-5" strokeWidth={1.75} aria-hidden="true" />
  <Moon className="theme-moon size-5" strokeWidth={1.75} aria-hidden="true" />
</button>
