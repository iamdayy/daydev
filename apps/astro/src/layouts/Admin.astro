---
import { actions } from "astro:actions";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Kelola konten Daydev studio: statistik, portofolio, artikel, dan testimoni.",
} = Astro.props;

const nav = [
  { href: "/admin", label: "Dashboard" },
  { href: "/admin/statistik", label: "Statistik" },
  { href: "/admin/portofolio", label: "Portofolio" },
  { href: "/admin/artikel", label: "Artikel" },
  { href: "/admin/testimoni", label: "Testimoni" },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} - Admin Daydev</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="min-h-screen bg-muted/50 text-foreground antialiased">
    <a href="#konten-admin" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-white focus:p-4">Lewati ke konten</a>
    <header class="sticky top-0 z-20 border-b border-border bg-[#172033] text-white">
      <div class="site-container grid grid-cols-[1fr_auto] items-center gap-x-4 py-3 lg:grid-cols-[auto_1fr_auto] lg:gap-8">
        <a href="/admin" class="inline-flex min-h-11 items-center text-lg font-bold tracking-tight">
          Daydev <span class="text-[#ea7b3c]">Admin</span>
        </a>
        <nav class="order-last col-span-2 mt-2 grid grid-cols-3 gap-1 sm:grid-cols-5 lg:order-none lg:col-span-1 lg:mt-0" aria-label="Navigasi admin">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={Astro.url.pathname === item.href ? "page" : undefined}
                class={`flex min-h-11 items-center justify-center rounded-lg px-2 py-2 text-sm font-medium transition-colors ${
                  Astro.url.pathname === item.href
                    ? "bg-white/10 text-white"
                    : "text-gray-300 hover:bg-white/5 hover:text-white"
                }`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <form
          action={actions.logout}
          method="POST"
          class="shrink-0"
          enctype="multipart/form-data"
        >
          <button
            type="submit"
            class="min-h-11 rounded-lg border border-white/20 px-3 py-2 text-sm font-medium text-gray-200 transition-colors hover:border-accent hover:text-accent"
          >
            Keluar
          </button>
        </form>
      </div>
    </header>

    <main id="konten-admin" tabindex="-1" class="site-container py-8 lg:py-10">
      <div class="mb-8">
        <h1 class="text-3xl font-bold tracking-tight sm:text-4xl">{title}</h1>
        {description && <p class="mt-2 max-w-2xl text-muted-foreground">{description}</p>}
      </div>
      <slot />
    </main>
  </body>
</html>
