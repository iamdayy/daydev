---
import { SEGMENT_LABELS, type Testimonial } from "@daydev/shared-types";

interface Props {
  testimonials: Testimonial[];
}

const { testimonials: items } = Astro.props;

const published = items
  .filter((t) => t.is_published)
  .sort((a, b) => a.display_order - b.display_order);

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Daydev Studio",
  url: "https://daydev.studio",
  review: published.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.client_name },
    reviewRating: { "@type": "Rating", ratingValue: t.rating },
    reviewBody: t.quote,
  })),
};
---

{
  published.length > 0 && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
      <section id="testimoni" class="bg-muted/40 py-24">
        <div class="mx-auto max-w-6xl px-4 sm:px-6">
          <div class="mb-16 text-center">
            <span class="fade-in mb-4 inline-block rounded-full border border-[#b45309]/25 bg-[#b45309]/10 px-4 py-2 text-sm font-semibold text-[#b45309]"
              >Testimoni Klien</span
            >
            <h2 class="fade-in text-3xl font-bold text-[#172033] sm:text-4xl lg:text-5xl">
              Mereka Sudah <span class="text-[#b45309]">Merasakan Manfaatnya</span>
            </h2>
            <p class="fade-in mx-auto max-w-2xl text-lg text-slate-600">
              Cerita dari startup, UMKM, dan mahasiswa yang membangun bersama
              Daydev.
            </p>
          </div>

          <div class="stagger-children grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
            {
              published.map((t) => (
                <div class="fade-in card-hover rounded-2xl border border-gray-100 bg-white p-6 shadow-sm">
                  <div class="flex gap-1" role="img" aria-label={`Rating ${t.rating} dari 5`}>
                    {
                      [...Array(Math.min(5, Math.max(0, t.rating)))].map((_, __) => (
                        <svg class="size-4 fill-current text-[#b45309]" viewBox="0 0 20 20" aria-hidden="true">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))
                    }
                  </div>

                  <p class="mt-4 mb-6 text-sm leading-relaxed text-slate-600">
                    &ldquo;{t.quote}&rdquo;
                  </p>

                  <div class="flex items-center gap-3 border-t border-gray-100 pt-4">
                    <div
                      class="flex size-10 shrink-0 items-center justify-center rounded-full bg-[#172033] text-sm font-bold text-white"
                      aria-hidden="true"
                    >
                      {t.client_name.charAt(0).toUpperCase()}
                    </div>
                    <div class="min-w-0 flex-1">
                      <div class="truncate text-sm font-semibold text-[#172033]">
                        {t.client_name}
                      </div>
                      <div class="truncate text-xs text-slate-500">
                        {t.client_role ?? "Klien Daydev"}
                      </div>
                    </div>
                    {
                      t.segment && (
                        <span class="shrink-0 rounded-full bg-muted px-2 py-1 text-xs font-medium text-primary">
                          {SEGMENT_LABELS[t.segment]}
                        </span>
                      )
                    }
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </section>
    </>
  )
}