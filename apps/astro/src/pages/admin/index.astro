---
import Admin from "../../layouts/Admin.astro";
import { getBlogPosts, getPortfolio, getStats, getTestimonials } from "../../lib/api";
import { BarChart3, FileText, FolderGit2, MessageSquareQuote } from "lucide-react";

export const prerender = false;

const [stats, portfolio, posts, testimonials] = await Promise.all([
  getStats().catch(() => []),
  getPortfolio().catch(() => []),
  getBlogPosts().catch(() => []),
  getTestimonials().catch(() => []),
]);

const cards = [
  {
    href: "/admin/statistik",
    icon: BarChart3,
    title: "Statistik",
    desc: "Kelola angka yang tampil di beranda (kosong = tidak tampil).",
    count: stats.length,
  },
  {
    href: "/admin/portofolio",
    icon: FolderGit2,
    title: "Portofolio",
    desc: "Tambah & terbitkan proyek lengkap dengan gambar sampul.",
    count: portfolio.length,
  },
  {
    href: "/admin/artikel",
    icon: FileText,
    title: "Artikel",
    desc: "Kelola konten blog dalam format markdown.",
    count: posts.length,
  },
  {
    href: "/admin/testimoni",
    icon: MessageSquareQuote,
    title: "Testimoni",
    desc: "Kurasi ulasan klien yang tampil di situs.",
    count: testimonials.length,
  },
];
---

<Admin title="Dashboard" description="Ringkasan konten situs dan pintasan pengelolaan.">
  <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      cards.map((card) => {
        const Icon = card.icon;
        return (
          <a
            href={card.href}
            class="group flex flex-col rounded-2xl border border-border bg-card p-6 shadow-sm transition-all hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg"
          >
            <div class="flex items-center justify-between">
              <div class="flex size-11 items-center justify-center rounded-xl bg-muted text-primary">
                <Icon className="size-5" aria-hidden="true" />
              </div>
              <span class="rounded-full bg-muted px-2.5 py-1 text-sm font-bold text-foreground">
                {card.count}
              </span>
            </div>
            <h2 class="mt-4 font-bold text-foreground group-hover:text-primary">
              {card.title}
            </h2>
            <p class="mt-1 text-sm leading-6 text-muted-foreground">{card.desc}</p>
          </a>
        );
      })
    }
  </div>

  <div class="mt-8 rounded-2xl border border-border bg-card p-6">
    <h2 class="font-bold text-foreground">Catatan</h2>
    <ul class="mt-3 space-y-2 text-sm leading-6 text-muted-foreground">
      <li>
        Statistik beranda hanya tampil bila datanya terisi — bila kosong, bagian
        tersebut otomatis disembunyikan.
      </li>
      <li>
        Perubahan konten baru terlihat di situs setelah halaman pratinjau
        di-build ulang saat deployment.
      </li>
      <li>
        Gambar sampul dapat diunggah langsung ke Cloudflare R2 lewat menu
        Portofolio.
      </li>
    </ul>
  </div>
</Admin>