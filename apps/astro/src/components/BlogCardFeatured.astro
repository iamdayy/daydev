---
import type { BlogPost } from "@daydev/shared-types";
import { ArrowUpRight, CalendarDays, Clock3 } from "lucide-react";

interface Props {
  article: BlogPost;
  href: string;
  index: number;
}

const { article, href, index } = Astro.props;

const formatDate = (iso: string) =>
  new Date(iso).toLocaleDateString("id-ID", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
---

<article class="group overflow-hidden rounded-3xl border border-border bg-card transition-transform duration-300 hover:-translate-y-1">
  <div
    class={`relative flex h-52 items-end overflow-hidden p-6 ${
      index === 0 ? "bg-secondary" : "bg-muted"
    }`}
  >
    {
      article.cover_image_url && (
        <img
          src={article.cover_image_url}
          alt={`Ilustrasi artikel ${article.title}`}
          loading="lazy"
          class="absolute inset-0 size-full object-cover"
        />
      )
    }
    <span class="relative rounded-full bg-secondary px-3 py-1.5 text-xs font-bold text-foreground">
      Insight
    </span>
  </div>

  <div class="flex flex-col gap-4 p-6 sm:p-8">
    <div class="flex flex-wrap items-center gap-4 text-xs font-medium text-muted-foreground">
      <span class="inline-flex items-center gap-1.5">
        <CalendarDays className="size-3.5" aria-hidden="true" />
        {formatDate(article.published_at)}
      </span>
      <span class="inline-flex items-center gap-1.5">
        <Clock3 className="size-3.5" aria-hidden="true" />
        {article.reading_minutes} menit baca
      </span>
    </div>
    <h3 class="text-2xl font-bold leading-tight text-foreground transition-colors group-hover:text-accent-ink sm:text-3xl">
      <a href={href}>{article.title}</a>
    </h3>
    <p class="line-clamp-3 leading-7 text-muted-foreground">{article.excerpt}</p>
    <div class="flex items-center justify-between border-t border-border pt-4 text-sm">
      <span class="font-semibold text-foreground">{article.author}</span>
      <a href={href} class="font-semibold text-accent-ink">
        Baca selengkapnya <ArrowUpRight className="ml-1 inline size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</article>
