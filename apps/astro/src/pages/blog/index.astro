---
import Base from "../../layouts/Base.astro";
import BlogBrowser from "../../components/BlogBrowser";
import { getBlogPosts, loadData } from "../../lib/api";

const posts = await loadData(getBlogPosts());

const published = (posts.data ?? [])
  .filter((p) => p.is_published)
  .sort(
    (a, b) =>
      new Date(b.published_at).getTime() - new Date(a.published_at).getTime(),
  )
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    excerpt: p.excerpt,
    cover_image_url: p.cover_image_url,
    author: p.author,
    reading_minutes: p.reading_minutes,
    published_at: p.published_at,
  }));

---

<Base
  title="Blog & Insight - Daydev Studio"
  description="Panduan praktis, perspektif produk, dan strategi teknologi untuk membangun website serta aplikasi yang benar-benar dipakai."
  canonicalPath="/blog"
>
  <main class="min-h-dvh bg-background text-foreground">
    <BlogBrowser client:load articles={published} loadError={!posts.ok} />
  </main>
</Base>
