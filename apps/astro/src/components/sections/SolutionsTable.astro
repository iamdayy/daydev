---
import { GraduationCap, Layers, Store } from "lucide-react";

const solutions = [
  { name: "Website & sistem bisnis", href: "/services/web-development", description: "Website profil, toko online, hingga sistem informasi dengan dashboard, laporan, dan manajemen data." },
  { name: "Aplikasi mobile", href: "/services/mobile-development", description: "Aplikasi iOS dan Android dengan notifikasi, sinkronisasi data, dan integrasi pembayaran." },
  { name: "AI & machine learning", href: "/services", description: "Eksplorasi otomasi dan fitur cerdas berdasarkan data serta proses yang ingin Anda sederhanakan." },
  { name: "Bot Telegram", href: "/services/telegram-bot", description: "Otomatisasi layanan pelanggan, pesan terjadwal, dan notifikasi yang terhubung ke sistem Anda." },
  { name: "Undangan digital", href: "/services/undangan-digital", description: "Undangan interaktif dengan RSVP, galeri, peta lokasi, dan pengelolaan tamu." },
];
const segmentNeeds = [
  { segment: "UMKM", icon: Store, needs: "Toko online, pengelolaan stok dan keuangan, serta layanan pelanggan otomatis." },
  { segment: "Mahasiswa", icon: GraduationCap, needs: "Sistem informasi untuk tugas akhir, bimbingan teknis, dan dokumentasi proyek." },
  { segment: "Startup", icon: Layers, needs: "MVP untuk validasi ide, integrasi layanan, dan pengembangan produk bertahap." },
];
---

<section id="solusi" class="section-space" aria-labelledby="solutions-title">
  <div class="site-container">
    <div class="solutions-layout">
      <div>
        <h2 id="solutions-title" class="section-title fade-in" style="max-width: 62ch;">Sesuai kebutuhan Anda.</h2>
        <p class="mt-6 max-w-sm text-lg leading-8 fade-in">Mulai dari yang paling dibutuhkan. Cakupan dan teknologi kita tentukan bersama.</p>
        <a href="/services" class="text-link mt-6 fade-in">Lihat layanan lengkap</a>
      </div>
      <ul class="solution-list">
        {solutions.map((solution) => (
          <li class="fade-in">
            <a href={solution.href} class="solution-row">
              <h3 class="text-2xl font-semibold tracking-tight">{solution.name}</h3>
              <p class="mt-3 leading-7 text-muted-foreground">{solution.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div class="audience-list">
      {segmentNeeds.map((item) => (
        <div class="fade-in">
          <h3 class="flex items-center gap-3 text-xl font-semibold"><item.icon className="size-5 shrink-0" strokeWidth={1.75} aria-hidden="true" />{item.segment}</h3>
          <p class="mt-4 leading-7 text-muted-foreground">{item.needs}</p>
        </div>
      ))}
    </div>
  </div>
</section>
