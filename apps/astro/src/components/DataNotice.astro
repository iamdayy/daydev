---
interface Props {
  title: string;
  message?: string;
  retryHref?: string;
}

const {
  title,
  message = "Silakan muat ulang halaman untuk mencoba lagi.",
  retryHref = Astro.url.pathname,
} = Astro.props;
---

<div role="status" class="rounded-2xl bg-muted p-6 text-foreground">
  <p class="font-semibold">{title}</p>
  <p class="mt-2 leading-7 text-muted-foreground">{message}</p>
  <a href={retryHref} class="mt-3 inline-flex min-h-11 items-center font-semibold text-primary underline underline-offset-4">Coba lagi</a>
</div>
