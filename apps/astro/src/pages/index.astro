---
import Base from "../layouts/Base.astro";
import BlogCardFeatured from "../components/BlogCardFeatured.astro";
import HeroComputer from "../components/HeroComputer";
import FeaturedProjects from "../components/sections/FeaturedProjects.astro";
import StatsSection from "../components/sections/StatsSection.astro";
import TargetMarket from "../components/sections/TargetMarket.astro";
import TeamSection from "../components/sections/TeamSection.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import {
  getBlogPosts,
  getPortfolio,
  getStats,
  getTeam,
  getTestimonials,
} from "../lib/api";
import { services } from "../lib/services";
import { waLink } from "@daydev/shared-types";
import { ArrowUpRight, Bot, Globe, Mail, Smartphone } from "lucide-react";

const serviceIcons: Record<string, typeof Globe> = {
  Globe,
  Smartphone,
  Bot,
  Mail,
};

const servicePreview = [
  {
    href: "/services/web-development",
    icon: Globe,
    title: "Web Development",
    desc: "Website modern & responsif",
  },
  {
    href: "/services/mobile-development",
    icon: Smartphone,
    title: "Mobile Apps",
    desc: "Aplikasi iOS & Android",
  },
  {
    href: "/services/telegram-bot",
    icon: Bot,
    title: "Bot Telegram",
    desc: "Automasi bisnis 24/7",
  },
  {
    href: "/services/undangan-digital",
    icon: Mail,
    title: "Undangan Digital",
    desc: "Undangan online interaktif",
  },
];

const [stats, team, portfolio, testimonials, posts] = await Promise.all([
  getStats(),
  getTeam(),
  getPortfolio(),
  getTestimonials(),
  getBlogPosts(),
]);
const featured = posts
  .filter((p) => p.is_published)
  .sort(
    (a, b) =>
      new Date(b.published_at).getTime() - new Date(a.published_at).getTime(),
  )
  .slice(0, 2);
---

<Base
  title="Daydev - Dari Ide Menjadi Aplikasi"
  description="Jasa pembuatan aplikasi Web & Mobile untuk Startup, UMKM, dan Mahasiswa. Konsultasi gratis, harga mulai Rp 99 ribu."
>
  <main id="beranda">
    <section class="relative overflow-hidden bg-[#172033] pb-20 pt-28">
      <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
      >
        <div
          class="absolute inset-0 bg-linear-to-b from-[#172033] via-[#172033]/95 to-[#172033]/30 lg:bg-linear-to-r lg:from-[#172033] lg:via-[#172033]/95 lg:to-[#172033]/30"
        >
        </div>
        <div
          class="absolute -right-32 -top-32 size-96 rounded-full bg-teal-700/20 blur-3xl"
        >
        </div>
      </div>

      <div class="relative mx-auto w-full max-w-6xl px-4 sm:px-6">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div class="text-center text-white lg:text-left">
            <div
              class="mb-6 inline-flex items-center gap-2 rounded-full border border-[#ea7b3c]/30 bg-[#ea7b3c]/15 px-4 py-2 text-sm font-medium text-[#ea7b3c]"
            >
              <span class="size-2 rounded-full bg-[#ea7b3c]"></span>
              Tersedia untuk proyek baru
            </div>

            <h1
              class="mb-6 text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl"
            >
              Dari Ide
              <br />
              <span class="text-[#ea7b3c]">Menjadi Aplikasi</span>
            </h1>

            <p
              class="mx-auto mb-8 max-w-xl text-lg leading-relaxed text-gray-300 sm:text-xl lg:mx-0"
            >
              Jasa pembuatan aplikasi <span class="font-semibold text-white"
                >Web &amp; Mobile</span
              > untuk{" "}
              <span class="font-semibold text-[#ea7b3c]">Startup</span>,{" "}
              <span class="font-semibold text-[#ea7b3c]">UMKM</span>, dan{" "}
              <span class="font-semibold text-[#ea7b3c]">Mahasiswa</span>.
            </p>

            <div
              class="flex flex-col justify-center gap-4 sm:flex-row lg:justify-start"
            >
              <a
                href={waLink(
                  "Halo Daydev, saya ingin konsultasi gratis mengenai pengembangan aplikasi.",
                )}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-[52px] items-center justify-center gap-2 rounded-full bg-[#ea7b3c] px-8 py-4 text-lg font-bold text-[#172033] shadow-lg transition-all duration-300 hover:brightness-110"
              >
                <svg
                  class="size-5 fill-current"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                >
                  <path
                    d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.890-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"
                  ></path>
                </svg>
                Konsultasi Gratis
              </a>
              <a
                href="#layanan"
                data-scroll
                class="flex min-h-[52px] items-center justify-center rounded-full border-2 border-white/30 px-8 py-4 text-lg font-semibold text-white transition-all duration-300 hover:border-[#ea7b3c] hover:text-[#ea7b3c]"
                >Jelajahi Layanan</a
              >
            </div>

            <ul
              class="mx-auto mt-8 grid max-w-xl grid-cols-2 gap-3 lg:mx-0"
              aria-label="Layanan Daydev"
            >
              {
                servicePreview.map((cell) => {
                  const Icon = cell.icon;
                  return (
                    <li>
                      <a
                        href={cell.href}
                        class="flex min-h-[64px] items-center gap-3 rounded-2xl border border-white/15 bg-white/5 px-4 py-3 transition-colors hover:border-[#ea7b3c]/60 hover:bg-white/10"
                      >
                        <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-[#172033] text-[#ea7b3c]">
                          <Icon className="size-5" aria-hidden="true" />
                        </span>
                        <span class="min-w-0 text-left">
                          <span class="block truncate text-sm font-bold text-white">
                            {cell.title}
                          </span>
                          <span class="block truncate text-xs text-gray-300">
                            {cell.desc}
                          </span>
                        </span>
                      </a>
                    </li>
                  );
                })
              }
            </ul>

            <p class="mt-4 text-xs text-gray-300">
              Status: Menerima proyek baru. Balas via WhatsApp pada jam kerja.
            </p>
          </div>

          <HeroComputer client:idle />
        </div>
      </div>
    </section>

    <script is:inline>
      document.addEventListener("click", (e) => {
        const target =
          e.target instanceof Element
            ? e.target.closest("[data-scroll]")
            : null;
        if (target) {
          e.preventDefault();
          const section = document.querySelector(
            target.getAttribute("data-scroll") || "",
          );
          section?.scrollIntoView({ behavior: "smooth" });
        }
      });
    </script>

    <TargetMarket />

    <StatsSection stats={stats} />

    <FeaturedProjects projects={portfolio} />

    <section class="bg-background px-4 py-24 sm:px-6">
      <div class="mx-auto max-w-6xl">
        <div
          class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
          <div class="max-w-2xl">
            <p
              class="mb-4 text-sm font-bold uppercase tracking-wide text-primary"
            >
              Layanan
            </p>
            <h2
              class="text-balance text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
            >
              Bisa dibuat bersama Daydev.
            </h2>
          </div>
          <a
            href="/services"
            class="inline-flex items-center gap-2 font-semibold text-primary transition-transform hover:translate-x-1"
            >Buka katalog layanan <ArrowUpRight
              className="size-4"
              aria-hidden="true"
            /></a
          >
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            services.map((service) => {
              const Icon = serviceIcons[service.icon] ?? Globe;
              return (
                <a
                  href={`/services/${service.slug}`}
                  class="group rounded-2xl border border-border bg-card p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-lg"
                >
                  <div class="mb-4 inline-flex size-12 items-center justify-center rounded-xl bg-[#172033] text-[#ea7b3c] transition-transform group-hover:scale-110">
                    <Icon className="size-6" aria-hidden="true" />
                  </div>
                  <h3 class="font-bold text-foreground group-hover:text-primary">
                    {service.title}
                  </h3>
                  <p class="mt-2 text-sm text-muted-foreground">
                    {service.description}
                  </p>
                </a>
              );
            })
          }
        </div>
      </div>
    </section>

    <Testimonials testimonials={testimonials} />

    <TeamSection teams={team} />

    <section class="bg-background px-4 py-24 sm:px-6" id="artikel">
      <div class="mx-auto max-w-6xl">
        <div
          class="mb-12 flex flex-col justify-between gap-6 md:flex-row md:items-end"
        >
          <div class="max-w-2xl">
            <p
              class="mb-4 text-sm font-bold uppercase tracking-wide text-primary"
            >
              Insight untuk langkah berikutnya
            </p>
            <h2
              class="text-balance text-3xl font-bold tracking-tight text-foreground sm:text-5xl"
            >
              Artikel yang membantu Anda membuat keputusan lebih baik.
            </h2>
            <p class="mt-4 max-w-xl leading-7 text-muted-foreground">
              Tips praktis, panduan teknis, dan sudut pandang produk untuk
              membangun digital product yang benar-benar dipakai.
            </p>
          </div>
          <a
            href="/blog"
            class="inline-flex items-center gap-2 font-semibold text-primary transition-transform hover:translate-x-1"
            >Baca semua artikel <ArrowUpRight
              className="size-4"
              aria-hidden="true"
            /></a
          >
        </div>

        {
          featured.length === 0 ? (
            <p class="text-center text-muted-foreground">
              Artikel baru sedang disiapkan. Ceritakan tantangan Anda sambil
              menunggu, kami siap di WhatsApp.
            </p>
          ) : (
            <div class="grid gap-6 lg:grid-cols-2">
              {featured.map((article, i) => (
                <BlogCardFeatured
                  article={article}
                  index={i}
                  href={`/blog/${article.slug}`}
                />
              ))}
            </div>
          )
        }
      </div>
    </section>
  </main>
</Base>
