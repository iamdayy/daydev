---
import { Menu, X } from "lucide-react";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import ThemeToggle from "./ThemeToggle.astro";

const navLinks = [
  { label: "Beranda", href: "/" },
  { label: "Layanan", href: "/services" },
  { label: "Harga", href: "/pricing" },
  { label: "Cerita pelanggan", href: "/portfolio" },
  { label: "Blog", href: "/blog" },
];
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
---

<header id="site-header" class="site-header">
  <div class="site-container">
    <div class="header-bar glass-surface">
      <a href="/" class="brand" aria-label="Daydev Studio - Beranda">
        <img
          src="/long-logo---dark.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="dark-logo"
        />
        <img
          src="/long-logo---light.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="light-logo"
        />
      </a>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class="nav-link"
              aria-current={isActive(link.href) ? "page" : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </nav>
      <div class="header-actions">
        <ThemeToggle />
        <a
          href={waLink(WHATSAPP.defaultMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary header-consultation">Konsultasi gratis</a
        >
        <details id="mobile-nav" class="mobile-nav">
          <summary
            id="menu-toggle"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            Menu
            <Menu className="menu-open size-5" aria-hidden="true" />
            <X className="menu-close size-5" aria-hidden="true" />
          </summary>
          <nav
            id="mobile-menu"
            class="mobile-nav-panel"
            aria-label="Navigasi mobile"
          >
            {
              navLinks.map((link) => (
                <a
                  href={link.href}
                  class="nav-link"
                  aria-current={isActive(link.href) ? "page" : undefined}
                >
                  {link.label}
                </a>
              ))
            }
            <a
              href={waLink(WHATSAPP.defaultMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="button-primary mt-4 w-full">Konsultasi gratis</a
            >
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menu = document.querySelector<HTMLDetailsElement>("#mobile-nav");
  const toggle = document.getElementById("menu-toggle");

  const closeMenu = () => {
    if (menu) menu.open = false;
  };
  menu?.addEventListener("toggle", () =>
    toggle?.setAttribute("aria-expanded", String(menu.open)),
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      closeMenu();
      toggle?.focus();
    }
  });
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a"))
      closeMenu();
  });
  header?.addEventListener("focusout", (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !header.contains(event.relatedTarget)
    )
      closeMenu();
  });
  document.addEventListener("pointerdown", (event) => {
    if (event.target instanceof Node && !header?.contains(event.target))
      closeMenu();
  });
  window
    .matchMedia("(min-width: 1101px)")
    .addEventListener("change", closeMenu);
</script>
