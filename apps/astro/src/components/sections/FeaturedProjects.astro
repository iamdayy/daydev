---
import { PORTFOLIO_CATEGORY_LABELS, waLink, type PortfolioItem } from "@daydev/shared-types";
import { ArrowUpRight } from "lucide-react";
import DataNotice from "../DataNotice.astro";
import ProjectImage from "../ProjectImage.astro";

interface Props { projects: PortfolioItem[]; loadError?: boolean; }
const { projects, loadError = false } = Astro.props;
const [featured, ...others] = projects
  .filter((project) => project.is_published)
  .sort((a, b) => a.display_order - b.display_order)
  .slice(0, 4);
---

<section id="proyek" class="section-space bg-background">
  <div class="site-container">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6">
      <h2 class="section-title">Proyek pilihan</h2>
      <a href="/portfolio" class="inline-flex min-h-11 items-center font-semibold text-primary">Lihat semua proyek</a>
    </div>
    {loadError ? <DataNotice title="Proyek unggulan belum dapat dimuat" /> : !featured ? (
      <div class="rounded-2xl bg-muted p-6">
        <p class="leading-7 text-muted-foreground">Studi kasus sedang disusun. Hubungi kami untuk melihat pekerjaan yang relevan dengan kebutuhan Anda.</p>
        <a href={waLink("Halo Daydev, saya ingin melihat portofolio untuk kebutuhan proyek saya.")} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-11 items-center font-semibold text-primary">Tanyakan portofolio</a>
      </div>
    ) : (
      <>
        <article class:list={["grid items-center gap-8 lg:gap-12", { "lg:grid-cols-[1.3fr_1fr]": featured.cover_image_url }]}>
          {featured.cover_image_url && (
            <div class="fade-in min-w-0">
              <ProjectImage src={featured.cover_image_url} title={featured.title} portrait={featured.category === "mobile"} />
            </div>
          )}
          <div class="fade-in min-w-0 max-w-2xl">
            <h3 class="text-3xl font-bold leading-tight tracking-tight">{featured.title}</h3>
            <p class="mt-3 text-sm text-primary">{PORTFOLIO_CATEGORY_LABELS[featured.category]}{featured.client_name && ` · ${featured.client_name}`}</p>
            <p class="mt-5 leading-7">{featured.description}</p>
            {featured.result_highlight && <p class="mt-5 rounded-xl bg-muted p-4 font-medium leading-7">{featured.result_highlight}</p>}
            {featured.tech_stack?.length ? <p class="mt-5 text-sm leading-6 text-muted-foreground">{featured.tech_stack.join(" · ")}</p> : null}
            {featured.demo_url && <a href={featured.demo_url} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-primary">Buka demo proyek <ArrowUpRight className="size-4" aria-hidden="true" /></a>}
          </div>
        </article>
        {others.length > 0 && (
          <div class="projects-supporting mt-14 grid gap-12 xl:grid-cols-3 xl:gap-8">
            {others.map((project) => (
              <article class:list={["fade-in grid min-w-0 items-start gap-5 xl:block", { "md:grid-cols-[1fr_1.15fr] md:gap-8": project.cover_image_url }]}>
                {project.cover_image_url && <ProjectImage src={project.cover_image_url} title={project.title} portrait={project.category === "mobile"} />}
                <div class="min-w-0 max-w-2xl xl:mt-5">
                  <h3 class="text-xl font-semibold leading-7 tracking-tight">{project.title}</h3>
                  <p class="mt-3 leading-7">{project.description}</p>
                  {project.demo_url && <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="text-link mt-3">Buka demo <ArrowUpRight className="size-4" aria-hidden="true" /></a>}
                </div>
              </article>
            ))}
          </div>
        )}
      </>
    )}
  </div>
</section>
