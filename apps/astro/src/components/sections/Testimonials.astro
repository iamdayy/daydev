---
import { SEGMENT_LABELS, type Testimonial } from "@daydev/shared-types";
import { Star } from "lucide-react";
import DataNotice from "../DataNotice.astro";

interface Props {
  testimonials: Testimonial[];
  loadError?: boolean;
}

const { testimonials: items, loadError = false } = Astro.props;
const published = items.filter((item) => item.is_published).sort((a, b) => a.display_order - b.display_order);
const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Daydev Studio",
  url: "https://daydev.studio",
  review: published.map((item) => ({
    "@type": "Review",
    author: { "@type": "Person", name: item.client_name },
    reviewRating: { "@type": "Rating", ratingValue: item.rating },
    reviewBody: item.quote,
  })),
};
---

{(loadError || published.length > 0) && (
  <section id="testimoni" class="section-space bg-muted" aria-labelledby="testimonials-title">
    {!loadError && <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />}
    <div class="site-container testimonials-layout">
      <h2 id="testimonials-title" class="section-title fade-in">Kata pelanggan.</h2>
      {loadError ? <DataNotice title="Testimoni belum dapat dimuat" /> : (
        <div class="space-y-12">
          {published.map((item) => (
            <figure class="fade-in">
              <div class="mb-5 flex gap-1" role="img" aria-label={`Rating ${item.rating} dari 5`}>
                {Array.from({ length: 5 }).map((_, index) => <Star className={`size-4 ${index < item.rating ? "fill-current" : "text-muted-foreground"}`} aria-hidden="true" />)}
              </div>
              <blockquote class="font-display text-xl font-medium leading-relaxed sm:text-2xl">&ldquo;{item.quote}&rdquo;</blockquote>
              <figcaption class="mt-6 flex items-center gap-4">
                {item.avatar_url && <div data-optional-image><img src={item.avatar_url} alt="" loading="lazy" width="48" height="48" class="size-12 rounded-full object-cover" /></div>}
                <div>
                  <p class="font-semibold">{item.client_name}</p>
                  {(item.client_role || item.segment) && <p class="mt-1 text-sm text-muted-foreground">{[item.client_role, item.segment && SEGMENT_LABELS[item.segment]].filter(Boolean).join(" · ")}</p>}
                </div>
              </figcaption>
            </figure>
          ))}
        </div>
      )}
    </div>
  </section>
)}
