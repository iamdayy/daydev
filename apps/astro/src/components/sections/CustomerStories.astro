---
import { waLink, type PortfolioItem } from "@daydev/shared-types";
import DataNotice from "../DataNotice.astro";
import ProjectCard from "../ProjectCard.astro";

interface Props {
  projects: PortfolioItem[];
  loadError?: boolean;
}

const { projects, loadError = false } = Astro.props;
const published = projects
  .filter((project) => project.is_published)
  .sort((a, b) => a.display_order - b.display_order)
  .slice(0, 3);
---

<section id="cerita-pelanggan" class="section-space bg-muted" aria-labelledby="stories-title">
  <div class="site-container">
    <div class="section-heading">
      <h2 id="stories-title" class="section-title fade-in">Ide yang sudah hidup.</h2>
      <p class="fade-in">Lihat bagaimana kebutuhan pelanggan diterjemahkan menjadi website dan aplikasi.</p>
    </div>
    {loadError ? (
      <DataNotice title="Cerita pelanggan belum dapat dimuat" />
    ) : published.length === 0 ? (
      <div class="max-w-2xl fade-in">
        <p class="leading-7 text-muted-foreground">Belum ada cerita pelanggan yang diterbitkan. Hubungi kami untuk melihat contoh proyek yang sesuai dengan kebutuhan Anda.</p>
        <a href={waLink("Halo Daydev, saya ingin melihat portofolio untuk kebutuhan proyek saya.")} target="_blank" rel="noopener noreferrer" class="text-link mt-4">Tanyakan portofolio</a>
      </div>
    ) : (
      <div class="projects-grid">
        {published.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
      </div>
    )}
    <a href="/portfolio" class="text-link mt-10 fade-in">Semua cerita pelanggan</a>
  </div>
</section>
