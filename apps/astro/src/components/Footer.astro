---
import { waLink, WHATSAPP } from "@daydev/shared-types";
import { services } from "../lib/services";
const currentYear = new Date().getFullYear();
---

<footer class="bg-foreground pb-24 pt-14 text-white sm:pb-10 sm:pt-16">
  <div class="site-container">
    <div class="grid gap-10 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a href="/" class="inline-flex min-h-11 items-center gap-3" aria-label="Daydev Studio - Beranda">
          <img src="/logo.png" alt="" width="40" height="40" class="rounded-lg bg-white p-2" />
          <span class="text-3xl font-bold tracking-tight">day<span class="text-accent">dev</span></span>
        </a>
        <p class="mt-5 max-w-sm leading-7 text-slate-300">Website dan aplikasi mobile untuk startup, UMKM, dan mahasiswa.</p>
      </div>
      <nav aria-label="Layanan di footer">
        <h2 class="mb-3 font-semibold">Layanan</h2>
        <ul>{services.map((service) => <li><a href={`/services/${service.slug}`} class="inline-flex min-h-11 items-center text-sm text-slate-300 hover:text-white">{service.title}</a></li>)}</ul>
      </nav>
      <div>
        <h2 class="mb-3 font-semibold">Hubungi Daydev</h2>
        <a href={waLink(WHATSAPP.defaultMessage)} target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center text-sm text-slate-300 hover:text-white">WhatsApp {WHATSAPP.displayNumber}</a>
        <a href="https://instagram.com/daydev__" target="_blank" rel="noopener noreferrer" class="flex min-h-11 items-center text-sm text-slate-300 hover:text-white">Instagram @daydev__</a>
        <nav aria-label="Halaman di footer" class="mt-4 flex flex-wrap gap-x-5">
          <a href="/portfolio" class="inline-flex min-h-11 items-center text-sm text-slate-300 hover:text-white">Portofolio</a>
          <a href="/pricing" class="inline-flex min-h-11 items-center text-sm text-slate-300 hover:text-white">Harga</a>
          <a href="/blog" class="inline-flex min-h-11 items-center text-sm text-slate-300 hover:text-white">Blog</a>
        </nav>
      </div>
    </div>
    <p class="mt-10 text-sm text-slate-300">&copy; {currentYear} Daydev. Semua hak dilindungi.</p>
  </div>
</footer>
