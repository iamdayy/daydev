---
import Admin from "../../layouts/Admin.astro";
import TestimonialManager from "../../components/admin/TestimonialManager";
import { getTestimonials, loadData } from "../../lib/api";
import DataNotice from "../../components/DataNotice.astro";

export const prerender = false;

const testimonials = await loadData(getTestimonials());
---

<Admin
  title="Testimoni"
  description="Kurasi ulasan klien. Rating & segmen ditampilkan di beranda, dan struktur review dipasang untuk schema.org."
>
  {testimonials.ok ? <TestimonialManager client:load initial={testimonials.data} /> : <DataNotice title="Testimoni belum dapat dimuat" />}
</Admin>
