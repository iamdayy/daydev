---
import { ArrowUpRight, Code, Github, Instagram, Layers, Mail, Zap } from "lucide-react";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import ConsultationCTA from "../components/ConsultationCTA.astro";
import Base from "../layouts/Base.astro";

const skills = [
  { name: "Web development", level: "Expert", tools: ["Astro", "React", "Node.js", "PostgreSQL", "Tailwind CSS"] },
  { name: "Mobile development", level: "Advanced", tools: ["React Native", "Expo", "iOS", "Android"] },
  { name: "AI / ML", level: "Intermediate", tools: ["Python", "LLM integration", "Data processing"] },
];

const focusAreas = [
  { icon: Code, title: "Product engineering", desc: "Membangun produk end-to-end: dari arsitektur hingga deployment." },
  { icon: Layers, title: "UI/UX design", desc: "Merancang antarmuka yang fungsional dan menyenangkan digunakan." },
  { icon: Zap, title: "Automation & AI", desc: "Mengotomatisasi proses dan menambahkan fitur cerdas berbasis data." },
];

const socialLinks = [
  { icon: Github, label: "GitHub", href: "https://github.com/iamdayy" },
  { icon: Instagram, label: "Instagram", href: "https://instagram.com/daydev__" },
  { icon: Mail, label: "WhatsApp", href: waLink(WHATSAPP.defaultMessage) },
];
---

<Base
  title="Founder - Daydev Studio"
  description="Kenali Dayan Sauqy, founder Daydev Studio. Software engineer dan product builder yang membangun solusi digital untuk kebutuhan nyata."
  canonicalPath="/founder"
>
  <main class="founder-page">
    <section class="founder-hero" aria-labelledby="founder-title">
      <div class="site-container founder-hero-grid">
        <div class="founder-hero-copy fade-in">
          <h1 id="founder-title"><span>Produk digital</span> yang dipakai.</h1>
          <p class="founder-lede">
            Saya Dayan, software engineer dan product builder di balik Daydev Studio.
            Dari ide pertama hingga produk siap digunakan, saya membantu membuat
            teknologi terasa lebih sederhana.
          </p>
          <div class="founder-hero-actions">
            <a href={waLink("Halo Daydev, saya ingin berdiskusi langsung dengan founder.")} target="_blank" rel="noopener noreferrer" class="founder-button">
              Mari berdiskusi <ArrowUpRight className="size-4" aria-hidden="true" />
            </a>
            <a href="#profile" class="founder-text-link">Kenali lebih dekat</a>
          </div>
          <div class="founder-social-row" aria-label="Temukan saya">
            <span>Temukan saya</span>
            {socialLinks.map((link) => (
              <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.label}>
                <link.icon className="size-4" aria-hidden="true" />
              </a>
            ))}
          </div>
        </div>
        <div class="founder-portrait-wrap fade-in">
          <div class="founder-portrait-backdrop" aria-hidden="true"></div>
          <img
            src="/founder-dayan-cutout.png"
            alt="Dayan Sauqy, founder Daydev Studio"
            class="founder-portrait"
            width="768"
            height="1365"
          />
          <p class="founder-portrait-note">Founder<br />Daydev Studio</p>
        </div>
      </div>
    </section>

    <section id="profile" class="founder-section founder-profile" aria-labelledby="profile-title">
      <div class="site-container founder-profile-grid">
        <div class="founder-section-heading fade-in">
          <h2 id="profile-title">Memahami manusia sebelum menulis kode.</h2>
        </div>
        <div class="founder-profile-copy fade-in">
          <p>
            Daydev Studio saya bangun dengan keyakinan sederhana: produk yang baik
            lahir dari pemahaman mendalam tentang masalah, bukan sekadar eksekusi teknis.
          </p>
          <p>
            Saya bekerja langsung dengan startup, UMKM, dan mahasiswa untuk merancang
            website, aplikasi mobile, serta eksplorasi AI/ML yang masuk akal dan bisa
            dipelihara jangka panjang.
          </p>
          <a href={waLink("Halo Daydev, saya ingin konsultasi langsung dengan founder.")} target="_blank" rel="noopener noreferrer" class="founder-text-link">
            Mulai percakapan <ArrowUpRight className="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>

    <section id="focus" class="founder-section founder-focus" aria-labelledby="focus-title">
      <div class="site-container">
        <div class="founder-section-heading founder-section-heading-wide fade-in">
          <h2 id="focus-title">Dari ide ke produk.</h2>
        </div>
        <div class="founder-focus-list">
          {focusAreas.map((area) => (
            <article class="founder-focus-item fade-in">
              <div>
                <h3>{area.title}</h3>
                <p>{area.desc}</p>
              </div>
              <ArrowUpRight className="founder-item-arrow size-5" aria-hidden="true" />
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="founder-section founder-skills" aria-labelledby="skills-title">
      <div class="site-container founder-skills-grid">
        <div class="founder-section-heading fade-in">
          <h2 id="skills-title">Teknologi untuk pekerjaan nyata.</h2>
        </div>
        <div class="founder-skill-list">
          {skills.map((skill) => (
            <article class="founder-skill fade-in">
              <div>
                <h3>{skill.name}</h3>
                <p>{skill.level}</p>
              </div>
              <div class="founder-tool-list">
                {skill.tools.map((tool) => <span>{tool}</span>)}
              </div>
            </article>
          ))}
          <a href="/dev/skills" class="founder-text-link">Lihat skills lengkap <ArrowUpRight className="size-4" aria-hidden="true" /></a>
        </div>
      </div>
    </section>

    <section id="approach" class="founder-section founder-approach" aria-labelledby="approach-title">
      <div class="site-container founder-approach-grid">
        <div class="fade-in">
          <h2 id="approach-title">Jujur sejak awal, jelas sampai akhir.</h2>
          <p class="founder-quote">
            “Saya akan selalu memberi tahu apa yang mungkin, apa yang tidak, dan mengapa—
            sebelum kode mulai ditulis.”
          </p>
        </div>
      </div>
    </section>

    <ConsultationCTA
      title="Yuk diskusi proyek Anda."
      description="Dari konsultasi gratis, kita bisa cari tahu apakah Daydev cocok untuk kebutuhan Anda."
      message="Halo Daydev, saya ingin konsultasi langsung dengan founder."
    />
  </main>
</Base>

<style is:global>
  .founder-page {
    --founder-ink: #17191d;
    --founder-muted: #68707a;
    --founder-accent: #e83d6b;
    --founder-wash: #f1f3f6;
    color: var(--founder-ink);
  }

  .founder-hero {
    overflow: hidden;
    background: var(--founder-wash);
  }

  .founder-hero-grid {
    display: grid;
    min-height: min(760px, calc(100vh - var(--site-header-height)));
    grid-template-columns: minmax(0, 0.95fr) minmax(360px, 1.05fr);
    align-items: center;
    gap: clamp(2rem, 8vw, 8rem);
  }

  .founder-hero-copy {
    padding-block: 5rem;
  }

  .founder-hero h1 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(3.2rem, 6vw, 6.6rem);
    font-weight: 700;
    letter-spacing: -0.065em;
    line-height: 0.98;
  }

  .founder-hero h1 span { color: var(--founder-accent); }

  .founder-lede {
    max-width: 510px;
    margin: 2rem 0 0;
    color: var(--founder-muted);
    font-size: clamp(1rem, 1.5vw, 1.18rem);
    line-height: 1.7;
  }

  .founder-hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.25rem;
  }

  .founder-button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.9rem 1.15rem;
    background: var(--founder-ink);
    color: white;
    font-size: 0.88rem;
    font-weight: 700;
    transition: transform 180ms ease, background 180ms ease;
  }

  .founder-button:hover { background: var(--founder-accent); transform: translateY(-2px); }

  .founder-text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--founder-ink);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: #bcc2c9;
    text-underline-offset: 0.35rem;
  }

  .founder-text-link:hover { color: var(--founder-accent); }

  .founder-social-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 4.5rem;
    color: var(--founder-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .founder-social-row a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    margin-left: 0.25rem;
    background: #e5e8ec;
    color: var(--founder-ink);
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .founder-social-row a:hover { background: white; color: var(--founder-accent); transform: translateY(-2px); }

  .founder-portrait-wrap {
    position: relative;
    align-self: stretch;
    min-height: 620px;
  }

  .founder-portrait-backdrop {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 80%;
    height: 78%;
    background: #e3e7ec;
  }

  .founder-portrait {
    position: absolute;
    right: 2%;
    bottom: 0;
    z-index: 1;
    width: min(100%, 560px);
    height: 94%;
    object-fit: contain;
    object-position: bottom center;
  }

  .founder-portrait-note {
    position: absolute;
    right: 0;
    top: 42%;
    z-index: 2;
    margin: 0;
    padding: 1rem 0.65rem;
    background: white;
    color: var(--founder-accent);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    text-align: center;
    text-transform: uppercase;
    writing-mode: vertical-rl;
  }

  .founder-section { padding-block: clamp(5rem, 10vw, 9.5rem); }
  .founder-profile { background: white; }
  .founder-profile-grid, .founder-skills-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(3rem, 10vw, 10rem);
  }
  .founder-section-heading h2, .founder-approach h2 {
    max-width: 700px;
    margin: 0;
    font-size: clamp(2.2rem, 4vw, 4.5rem);
    letter-spacing: -0.055em;
    line-height: 1.02;
  }
  .founder-profile-copy { max-width: 570px; padding-top: 2.2rem; }
  .founder-profile-copy p, .founder-quote { margin: 0 0 1.5rem; color: var(--founder-muted); font-size: 1.1rem; line-height: 1.8; }
  .founder-profile-copy .founder-text-link { margin-top: 1rem; }
  .founder-focus { background: var(--founder-wash); }
  .founder-section-heading-wide { max-width: 650px; margin-bottom: 4rem; }
  .founder-focus-list { display: grid; gap: 0.75rem; }
  .founder-focus-item { display: grid; grid-template-columns: 3rem 1fr auto; align-items: center; gap: 1rem; padding: 1.7rem; background: white; }
  .founder-focus-item h3, .founder-skill h3 { margin: 0; font-size: 1.25rem; font-weight: 700; }
  .founder-focus-item p { margin: 0.3rem 0 0; color: var(--founder-muted); }
  .founder-focus-item svg:first-child { color: var(--founder-accent); }
  .founder-item-arrow { color: var(--founder-muted); }
  .founder-skills { background: white; }
  .founder-skill-list { display: grid; gap: 0.75rem; }
  .founder-skill { display: grid; grid-template-columns: minmax(130px, 0.45fr) 1fr; gap: 2rem; padding: 1.5rem; background: var(--founder-wash); }
  .founder-skill p { margin: 0.25rem 0 0; color: var(--founder-accent); font-size: 0.82rem; font-weight: 700; }
  .founder-tool-list { display: flex; flex-wrap: wrap; gap: 0.5rem; align-content: start; }
  .founder-tool-list span { padding: 0.38rem 0.65rem; background: var(--founder-wash); color: var(--founder-muted); font-size: 0.82rem; }
  .founder-skill-list > .founder-text-link { margin-top: 2rem; }
  .founder-approach { background: var(--founder-ink); color: white; }
  .founder-approach .founder-kicker { color: #aab1bb; }
  .founder-approach-grid { display: grid; grid-template-columns: 0.45fr 1.55fr; gap: 3rem; }
  .founder-approach h2 { max-width: 850px; }
  .founder-quote { max-width: 650px; margin-top: 2.5rem; color: #aab1bb; }

  @media (max-width: 800px) {
    .founder-hero-grid, .founder-profile-grid, .founder-skills-grid, .founder-approach-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .founder-hero-copy { padding-block: 4rem 1rem; }
    .founder-hero h1 { font-size: clamp(3rem, 14vw, 5rem); }
    .founder-social-row { margin-top: 3rem; }
    .founder-portrait-wrap { min-height: 430px; margin-top: -1rem; }
    .founder-portrait { right: 5%; width: 88%; height: 100%; }
    .founder-portrait-backdrop { width: 82%; height: 78%; }
    .founder-portrait-note { top: 32%; }
    .founder-profile-copy { padding-top: 0; }
    .founder-skill { grid-template-columns: 1fr; gap: 1rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .founder-button, .founder-social-row a { transition: none; }
  }
</style>
