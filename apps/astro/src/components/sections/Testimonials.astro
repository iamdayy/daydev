---
import { SEGMENT_LABELS, type Testimonial } from "@daydev/shared-types";

interface Props {
  testimonials: Testimonial[];
}

const { testimonials: items } = Astro.props;

const published = items
  .filter((t) => t.is_published)
  .sort((a, b) => a.display_order - b.display_order);

const reviewSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "Daydev Studio",
  url: "https://daydev.studio",
  review: published.map((t) => ({
    "@type": "Review",
    author: { "@type": "Person", name: t.client_name },
    reviewRating: { "@type": "Rating", ratingValue: t.rating },
    reviewBody: t.quote,
  })),
};
---

{
  published.length > 0 && (
    <>
      <script type="application/ld+json" set:html={JSON.stringify(reviewSchema)} />
      <section id="testimoni" class="section-space bg-muted">
        <div class="site-container">
          <h2 class="section-title mb-10">Cerita klien</h2>
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,24rem),1fr))] gap-x-16 gap-y-10">
            {
              published.map((t) => (
                <figure class="fade-in min-w-0">
                  <blockquote class="text-xl leading-8 text-foreground">&ldquo;{t.quote}&rdquo;</blockquote>
                  <figcaption class="mt-5">
                    <p class="font-semibold">{t.client_name}</p>
                    {t.client_role && <p class="mt-1 text-sm text-muted-foreground">{t.client_role}</p>}
                    <p class="mt-2 text-sm text-muted-foreground">Rating {t.rating} dari 5{t.segment && ` · ${SEGMENT_LABELS[t.segment]}`}</p>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </section>
    </>
  )
}
