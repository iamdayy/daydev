---
import Base from "../layouts/Base.astro";
import PriceCalculator from "../components/PriceCalculator";
import PricingSection from "../components/sections/PricingSection.astro";
import DataNotice from "../components/DataNotice.astro";
import { getPricing, loadData } from "../lib/api";
import { waLink } from "@daydev/shared-types";
import { ChevronDown, CreditCard, Banknote } from "lucide-react";

const pricing = await loadData(getPricing());

// Reorder: UMKM → Mahasiswa → Startup (main), then Bot Telegram & Undangan Digital (additional)
const segmentOrder = ["umkm", "mahasiswa", "startup", "bot-telegram", "undangan-digital"];

const faqs = [
  {
    question: "Bagaimana biaya kebutuhan tambahan dihitung?",
    answer: "Harga dasar mengikuti paket yang Anda pilih. Tuliskan fitur atau integrasi tambahan pada ringkasan estimasi, lalu kami konfirmasi cakupan dan biayanya saat konsultasi."
  },
  {
    question: "Berapa banyak revisi yang termasuk?",
    answer: "Cakupan revisi mengikuti paket yang dipilih dan kesepakatan proyek. Periksa fitur yang tercantum, lalu konfirmasikan kebutuhan revisi sebelum pekerjaan dimulai."
  },
  {
    question: "Apakah harga termasuk maintenance dan support?",
    answer: "Periksa cakupan pada masing-masing paket. Kebutuhan hosting, maintenance, dan dukungan lanjutan dapat dibahas saat konsultasi."
  },
  {
    question: "Bagaimana proses pembayaran?",
    answer: "Pembayaran mengikuti skema down payment (DP) dan progress payment. DP umumnya 30–50% saat kontrak, sisanya dibagi per milestone yang disepakati. Kami terima transfer bank dan e-wallet."
  },
  {
    question: "Apakah bisa cicilan tanpa kartu kredit?",
    answer: "Ya. Skema progress payment sudah merupakan bentuk cicilan berdasarkan kemajuan proyek, bukan cicilan kartu kredit. Detailnya dibahas saat konsultasi."
  },
  {
    question: "Apakah ada garansi uang kembali?",
    answer: "Kami berkomitmen pada kesepakatan cakupan dan timeline. Jika kami tidak memenuhi yang tertulis di kontrak, pengembalian dana dibahas secara adil. Detailnya tercantum di perjanjian kerja."
  }
];
---

<Base title="Harga & Paket - Daydev Studio" description="Bandingkan paket layanan Daydev untuk UMKM, Mahasiswa, dan Startup. Susun estimasi berdasarkan kebutuhan proyek Anda. Konsultasi gratis via WhatsApp." canonicalPath="/pricing">
  <main class="bg-background text-foreground">
    <!-- Hero Section -->
    <section class="section-space bg-card">
      <div class="site-container">
        <div class="max-w-3xl mx-auto text-center fade-in">
          <h1 class="page-title">Harga & paket</h1>
          <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground mx-auto">
            Setiap bisnis punya tahap dan anggaran berbeda. Pilih paket sebagai titik awal,
            lalu kita sesuaikan cakupannya bersama. Tidak ada biaya tersembunyi.
          </p>
        </div>
      </div>
    </section>

    <!-- Main Pricing Section -->
    {pricing.ok ? (
      <>
        <PricingSection categories={pricing.data} segmentOrder={segmentOrder} />
        <PriceCalculator client:visible categories={pricing.data} />
      </>
    ) : (
      <div class="site-container py-12"><DataNotice title="Daftar harga belum dapat dimuat" /></div>
    )}

    <!-- Payment FAQ -->
    <section class="section-space bg-background" aria-labelledby="payment-faq-title">
      <div class="site-container">
        <div class="mb-12 text-center max-w-3xl mx-auto fade-in">
          <h2 id="payment-faq-title" class="section-title">Tentang pembayaran</h2>
          <p class="mt-5 text-lg leading-8 text-muted-foreground">
            Kami ingin Anda nyaman dengan alur pembayaran. Berikut pertanyaan yang sering diajukan.
          </p>
        </div>
        <div class="space-y-3 max-w-3xl mx-auto">
          {faqs.map((faq) => (
            <details class="group fade-in rounded-2xl bg-card border border-border p-6">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                {faq.question}
                <ChevronDown className="size-5 shrink-0 transition-transform group-open:rotate-180 text-muted-foreground" aria-hidden="true" />
              </summary>
              <div class="mt-4 flex items-start gap-4">
                <div class="shrink-0 w-10 h-10 rounded-xl bg-primary/10 flex items-center justify-center">
                  <CreditCard className="w-5 h-5 text-primary" aria-hidden="true" />
                </div>
                <p class="leading-7 text-muted-foreground">{faq.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- Down Payment Info -->
    <section class="section-space bg-muted" aria-labelledby="dp-title">
      <div class="site-container">
        <div class="rounded-2xl bg-card border border-border p-6 sm:p-8 md:p-10 max-w-3xl mx-auto fade-in">
          <div class="flex items-start gap-4">
            <div class="shrink-0 w-12 h-12 rounded-xl bg-amber/10 flex items-center justify-center">
              <Banknote className="w-6 h-6 text-amber-600" aria-hidden="true" />
            </div>
            <div>
              <h3 id="dp-title" class="text-xl font-bold text-foreground">Skema Down Payment & Progress Payment</h3>
              <p class="mt-3 leading-7 text-muted-foreground">
                Kami memahami arus kas bisnis. Pembayaran dibagi tahap demi tahap seiring kemajuan proyek:
              </p>
              <ul class="mt-4 list-disc space-y-3 pl-5 leading-7 text-muted-foreground">
                <li><strong>DP 30–50%</strong> saat penandatanganan kontrak — memulai riset & desain</li>
                <li><strong>Progress 30–40%</strong> saat desain disetujui — memulai development</li>
                <li><strong>Pelunasan 20–30%</strong> saat UAT (User Acceptance Testing) lulus — sebelum go-live</li>
              </ul>
              <p class="mt-4 text-sm leading-6 text-muted-foreground">
                Persentase pasti disesuaikan skala proyek dan ditulis jelas di perjanjian kerja. Tidak ada biaya tak terduga.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="section-space bg-primary text-white">
      <div class="site-container flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div class="fade-in max-w-xl">
          <h2 class="section-title">Belum yakin paket mana yang cocok?</h2>
          <p class="mt-5 max-w-xl text-lg leading-8">
            Ceritakan kebutuhan dan anggaran Anda. Kita tentukan cakupan proyek bersama lewat percakapan ringan—tanpa tekanan.
          </p>
        </div>
        <a
          href={waLink("Halo Daydev, saya ingin diskusikan paket yang cocok untuk proyek saya.")}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary shrink-0 fade-in-right"
        >
          Diskusikan via WhatsApp
        </a>
      </div>
    </section>
  </main>
</Base>