---
import { Menu, X } from "lucide-react";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import ThemeToggle from "./ThemeToggle.astro";

const navGroups = [
  {
    label: "Studio",
    links: [
      { label: "Beranda", href: "/" },
      { label: "Layanan", href: "/services" },
      { label: "Cerita pelanggan", href: "/portfolio" },
    ],
  },
  {
    label: "Mulai proyek",
    links: [
      { label: "Konsultasi & harga", href: "/pricing" },
      { label: "Catatan studio", href: "/blog" },
    ],
  },
];
const navLinks = navGroups.flatMap((group) => group.links);
const pathname = Astro.url.pathname;
const isActive = (href: string) =>
  pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
---

<header id="site-header" class="site-header">
  <div class="site-container">
    <div class="header-bar glass-surface">
      <a href="/" class="brand" aria-label="Daydev Studio - Beranda">
        <img
          src="/long-logo---dark.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="dark-logo"
        />
        <img
          src="/long-logo---light.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="light-logo"
        />
      </a>
      <div class="sidebar-intro">
        <p class="sidebar-kicker">Founder-led digital product studio</p>
        <p class="sidebar-description">Daydev membantu mengubah kebutuhan bisnis menjadi produk digital yang bisa dipakai.</p>
      </div>
      <nav class="desktop-nav" aria-label="Navigasi utama">
        {navGroups.map((group) => (
          <div class="nav-group">
            <p class="nav-group-label">{group.label}</p>
            {group.links.map((link) => (
              <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
                {link.label}
              </a>
            ))}
          </div>
        ))}
      </nav>
      <div class="header-actions">
        <ThemeToggle />
        <a
          href={waLink(WHATSAPP.defaultMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary header-consultation">Konsultasi gratis</a
        >
        <details id="mobile-nav" class="mobile-nav">
          <summary
            id="menu-toggle"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            Menu
            <Menu className="menu-open size-5" aria-hidden="true" />
            <X className="menu-close size-5" aria-hidden="true" />
          </summary>
          <nav
            id="mobile-menu"
            class="mobile-nav-panel"
            aria-label="Navigasi mobile"
          >
          {navLinks.map((link) => (
            <a href={link.href} class="nav-link" aria-current={isActive(link.href) ? "page" : undefined}>
              {link.label}
            </a>
          ))}
            <a
              href={waLink(WHATSAPP.defaultMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="button-primary mt-4 w-full">Konsultasi gratis</a
            >
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menu = document.querySelector<HTMLDetailsElement>("#mobile-nav");
  const toggle = document.getElementById("menu-toggle");

  const closeMenu = () => {
    if (menu) menu.open = false;
  };
  menu?.addEventListener("toggle", () =>
    toggle?.setAttribute("aria-expanded", String(menu.open)),
  );
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      closeMenu();
      toggle?.focus();
    }
  });
  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a"))
      closeMenu();
  });
  header?.addEventListener("focusout", (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !header.contains(event.relatedTarget)
    )
      closeMenu();
  });
  document.addEventListener("pointerdown", (event) => {
    if (event.target instanceof Node && !header?.contains(event.target))
      closeMenu();
  });
  window
    .matchMedia("(min-width: 1101px)")
    .addEventListener("change", closeMenu);
</script>
