---
import { PORTFOLIO_CATEGORY_LABELS, waLink, type PortfolioItem } from "@daydev/shared-types";
import { ArrowUpRight, Users, Target, Zap } from "lucide-react";
import DataNotice from "../DataNotice.astro";
import ProjectImage from "../ProjectImage.astro";

interface Props {
  projects: PortfolioItem[];
  loadError?: boolean;
}

const { projects, loadError = false } = Astro.props;

const published = (projects ?? [])
  .filter((project) => project.is_published)
  .sort((a, b) => a.display_order - b.display_order);

const segmentIcons: Record<string, typeof Users | typeof Target | typeof Zap> = {
  umkm: Users,
  startup: Target,
  mahasiswa: Zap,
  "bot-telegram": Users,
  "undangan-digital": Zap,
};
---

<section id="cerita-pelanggan" class="section-space bg-background" aria-labelledby="stories-title">
  <div class="site-container">
    <div class="mb-12 text-center max-w-3xl mx-auto fade-in">
      <h2 id="stories-title" class="section-title">Cerita pelanggan</h2>
      <p class="mt-5 text-lg leading-8 text-muted-foreground">
        Bukan daftar fitur, tapi cerita transformasi nyata. Setiap proyek bermula dari tantangan,
        berakhir dengan solusi yang dipakai setiap hari.
      </p>
    </div>

    {loadError ? (
      <DataNotice title="Cerita pelanggan belum dapat dimuat" />
    ) : published.length === 0 ? (
      <div class="rounded-2xl bg-muted p-10 text-center fade-in">
        <div class="mx-auto w-16 h-16 rounded-2xl bg-primary/10 flex items-center justify-center mb-4">
          <Users className="w-8 h-8 text-primary" aria-hidden="true" />
        </div>
        <h3 class="text-xl font-semibold text-foreground">Cerita masih kosong</h3>
        <p class="mt-3 leading-7 text-muted-foreground max-w-md mx-auto">
          Kami baru memulai perjalanan bersama pelanggan. Kembali nanti untuk melihat transformasi
          bisnis UMKM, mahasiswa, dan startup yang kami bantu.
        </p>
        <a
          href={waLink("Halo Daydev, saya ingin melihat portofolio untuk kebutuhan proyek saya.")}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex min-h-11 items-center font-semibold text-primary"
        >
          Tanyakan portofolio
        </a>
      </div>
    ) : (
      <div class="stagger-children grid gap-8 md:gap-10">
        {published.map((project) => {
          const Icon = segmentIcons[project.segment ?? "umkm"] ?? Users;
          const segmentLabel = project.segment ? PORTFOLIO_CATEGORY_LABELS[project.segment as keyof typeof PORTFOLIO_CATEGORY_LABELS] : PORTFOLIO_CATEGORY_LABELS[project.category];

          return (
            <article class="fade-in group relative rounded-2xl bg-card border border-border overflow-hidden transition-all duration-300 hover:shadow-lg hover:-translate-y-1 hover:border-primary/30">
              <div class:list={["grid gap-6 lg:gap-8", { "lg:grid-cols-[1.1fr_1fr]": project.cover_image_url }]}>
                {project.cover_image_url && (
                  <div class="relative min-w-0">
                    <a href={project.demo_url ?? "#"} target="_blank" rel="noopener noreferrer" aria-label={`Buka demo ${project.title}`} class="block aspect-[4/3] overflow-hidden">
                      <ProjectImage src={project.cover_image_url} title={project.title} portrait={project.category === "mobile"} />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300" aria-hidden="true" />
                    </a>
                    <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 translate-y-2 group-hover:translate-y-0">
                      <span class="px-3 py-1.5 text-xs font-medium bg-white/90 backdrop-blur-sm rounded-full text-foreground">
                        {segmentLabel}
                      </span>
                      {project.demo_url && (
                        <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="p-2 bg-white/90 backdrop-blur-sm rounded-full text-foreground hover:bg-white transition-colors" aria-label="Buka demo proyek">
                          <ArrowUpRight className="w-4 h-4" aria-hidden="true" />
                        </a>
                      )}
                    </div>
                  </div>
                )}
                <div class="min-w-0 p-6 sm:p-8 lg:p-6 flex flex-col justify-center">
                  <div class="flex items-center gap-2 mb-4">
                    <Icon className="w-5 h-5 text-primary" aria-hidden="true" />
                    <span class="text-sm font-medium text-primary">{segmentLabel}</span>
                    {project.client_name && <span class="text-sm text-muted-foreground">· {project.client_name}</span>}
                  </div>
                  <h3 class="text-2xl sm:text-3xl font-bold leading-tight tracking-tight text-foreground group-hover:text-primary transition-colors">{project.title}</h3>
                  <p class="mt-4 leading-7 text-muted-foreground">{project.description}</p>
                  {project.result_highlight && (
                    <div class="mt-5 rounded-xl bg-primary/5 border border-primary/20 p-4">
                      <p class="font-medium leading-7 text-foreground flex items-start gap-2">
                        <svg class="w-5 h-5 shrink-0 mt-0.5 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                        {project.result_highlight}
                      </p>
                    </div>
                  )}
                  {project.tech_stack?.length && (
                    <p class="mt-5 text-sm leading-6 text-muted-foreground flex flex-wrap gap-2">
                      {project.tech_stack.map((tech) => (
                        <span class="px-2.5 py-1 text-xs bg-muted rounded-full">{tech}</span>
                      ))}
                    </p>
                  )}
                  {project.demo_url && (
                    <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="mt-6 inline-flex min-h-11 items-center gap-2 font-semibold text-primary group-hover:gap-3 transition-all">
                      Buka demo proyek
                      <ArrowUpRight className="size-4 shrink-0" aria-hidden="true" />
                    </a>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}
  </div>
</section>