---
import { Menu, X, Sun, Moon } from "lucide-react";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import { navigationGroups, isActive } from "./navigation";

const pathname = Astro.url.pathname;
---

<header id="site-header" class="site-header">
  <div class="site-container">
    <div class="header-bar glass-surface">
      <a href="/" class="brand" aria-label="Daydev Studio - Beranda">
        <img
          src="/long-logo---dark.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="dark-logo"
        />
        <img
          src="/long-logo---light.png"
          alt="Logo Daydev"
          height="36"
          width="120"
          class="light-logo"
        />
        <img
          src="/Short-Logo.png"
          alt=""
          height="36"
          width="36"
          class="mobile-logo"
        />
      </a>

      <nav class="desktop-nav" aria-label="Navigasi utama">
        {
          navigationGroups.map((group) => (
            <div class="nav-group">
              <p class="nav-group-label">{group.label}</p>
              {group.items.map((link) => (
                <a
                  href={link.href}
                  class="nav-link"
                  aria-current={
                    isActive(pathname, link.href) ? "page" : undefined
                  }
                  data-group={group.label}
                >
                  {link.label}
                </a>
              ))}
            </div>
          ))
        }
      </nav>

      <div class="header-actions">
        <button
          type="button"
          class="icon-button theme-toggle"
          data-theme-toggle
          aria-label="Aktifkan tema gelap"
          aria-pressed="false"
        >
          <Sun
            className="theme-sun size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
          <Moon
            className="theme-moon size-5"
            strokeWidth={1.75}
            aria-hidden="true"
          />
        </button>

        <a
          href={waLink(WHATSAPP.defaultMessage)}
          target="_blank"
          rel="noopener noreferrer"
          class="button-primary header-consultation"
        >
          Konsultasi gratis
        </a>

        <details id="mobile-nav" class="mobile-nav">
          <summary
            id="menu-toggle"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            Menu
            <Menu className="menu-open size-5" aria-hidden="true" />
            <X className="menu-close size-5" aria-hidden="true" />
          </summary>
          <nav
            id="mobile-menu"
            class="mobile-nav-panel"
            aria-label="Navigasi mobile"
          >
            {
              navigationGroups.map((group) => (
                <div class="nav-group mb-4">
                  <p class="nav-group-label mb-2">{group.label}</p>
                  {group.items.map((link) => (
                    <a
                      href={link.href}
                      class="nav-link"
                      aria-current={
                        isActive(pathname, link.href) ? "page" : undefined
                      }
                      data-group={group.label}
                    >
                      {link.label}
                    </a>
                  ))}
                </div>
              ))
            }
            <a
              href={waLink(WHATSAPP.defaultMessage)}
              target="_blank"
              rel="noopener noreferrer"
              class="button-primary mt-4 w-full"
            >
              Konsultasi gratis
            </a>
          </nav>
        </details>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const menu = document.querySelector<HTMLDetailsElement>("#mobile-nav");
  const toggle = document.getElementById("menu-toggle");

  const closeMenu = () => {
    if (menu) menu.open = false;
  };

  menu?.addEventListener("toggle", () =>
    toggle?.setAttribute("aria-expanded", String(menu.open)),
  );

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu?.open) {
      closeMenu();
      toggle?.focus();
    }
  });

  menu?.addEventListener("click", (event) => {
    if (event.target instanceof Element && event.target.closest("a"))
      closeMenu();
  });

  header?.addEventListener("focusout", (event) => {
    if (
      event.relatedTarget instanceof Node &&
      !header.contains(event.relatedTarget)
    )
      closeMenu();
  });

  document.addEventListener("pointerdown", (event) => {
    if (event.target instanceof Node && !header?.contains(event.target))
      closeMenu();
  });

  window
    .matchMedia("(min-width: 1101px)")
    .addEventListener("change", closeMenu);
</script>

<style is:global>
  .theme-toggle {
    display: none;
  }
  [data-theme-ready] .theme-toggle {
    display: inline-flex;
  }
  .theme-sun,
  [data-theme="dark"] .theme-moon {
    display: none;
  }
  [data-theme="dark"] .theme-sun {
    display: block;
  }
</style>
