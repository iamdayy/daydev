---
import Base from "../layouts/Base.astro";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import ConsultationCTA from "../components/ConsultationCTA.astro";
import { Github, Instagram, Mail, MapPin, Code, Layers, Zap } from "lucide-react";

const skills = [
  { name: "Web Development", level: "Expert", tools: ["Astro", "React", "Node.js", "PostgreSQL", "Tailwind CSS"] },
  { name: "Mobile Development", level: "Advanced", tools: ["React Native", "Expo", "iOS", "Android"] },
  { name: "AI / ML", level: "Intermediate", tools: ["Python", "LLM Integration", "Data Processing"] },
];

const focusAreas = [
  { icon: Code, title: "Product Engineering", desc: "Membangun produk end-to-end: dari arsitektur hingga deployment." },
  { icon: Layers, title: "UI/UX Design", desc: "Merancang antarmuka yang fungsional dan menyenangkan digunakan." },
  { icon: Zap, title: "Automation & AI", desc: "Mengotomatisasi proses dan menambahkan fitur cerdas berbasis data." },
];

const socialLinks = [
  { icon: Github, label: "GitHub", href: "https://github.com/iamdayy" },
  { icon: Instagram, label: "Instagram", href: "https://instagram.com/daydev__" },
  { icon: Mail, label: "WhatsApp", href: waLink(WHATSAPP.defaultMessage) },
];
---

<Base
  title="Founder - Daydev Studio"
  description="Kenali founder di balik Daydev Studio. Software engineer dan product builder yang berfokus pada solusi digital yang masuk akal untuk startup, UMKM, dan mahasiswa."
  canonicalPath="/founder"
>
  <main>
    <header class="page-intro">
      <div class="site-container page-intro-grid">
        <h1 class="page-title">Founder Daydev.</h1>
        <p>Software engineer dan product builder di balik Daydev Studio. Fokus pada membangun produk digital yang benar-benar digunakan.</p>
      </div>
    </header>

    <section id="profile" class="section-space" aria-labelledby="profile-title">
      <div class="site-container">
        <div class="grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
          <div class="fade-in">
            <div class="flex size-32 items-center justify-center rounded-3xl bg-secondary font-display text-5xl font-bold text-foreground sm:size-40" aria-hidden="true">
              D
            </div>
            <div class="mt-8 space-y-4">
              <p class="flex items-center gap-3 text-muted-foreground"><MapPin className="size-5 text-accent-ink" aria-hidden="true" />Indonesia</p>
              {socialLinks.map((link) => (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="flex items-center gap-3 text-foreground hover:text-accent-ink transition-colors">
                  <link.icon className="size-5 text-accent-ink" aria-hidden="true" />{link.label}
                </a>
              ))}
            </div>
          </div>
          <div class="fade-in">
            <h2 id="profile-title" class="section-title">Daydev Founder</h2>
            <p class="mt-4 text-lg font-semibold text-accent-ink">Software Engineer & Product Builder</p>
            <div class="mt-8 space-y-6 text-lg leading-8">
              <p>Founder Daydev Studio dengan fokus pada pengembangan produk digital end-to-end. Berpengalaman membangun website, aplikasi mobile, dan eksplorasi solusi AI/ML untuk berbagai klien—dari UMKM, mahasiswa, hingga startup.</p>
              <p>Pendekatan kerja mengutamakan komunikasi transparan, decisions berbasis data, dan kode yang dapat dipelihara jangka panjang. Setiap proyek dimulai dari pemahaman masalah nyata, bukan sekadar eksekusi teknis.</p>
            </div>
            <a href={waLink("Halo Daydev, saya ingin berdiskusi langsung dengan founder.")} target="_blank" rel="noopener noreferrer" class="button-primary mt-8">
              Hubungi via WhatsApp
            </a>
          </div>
        </div>
      </div>
    </section>

    <section id="focus" class="section-space bg-muted" aria-labelledby="focus-title">
      <div class="site-container">
        <div class="section-heading">
          <h2 id="focus-title" class="section-title fade-in">Area fokus.</h2>
          <p class="fade-in">Tiga bidang yang menjadi spesialisasi utama.</p>
        </div>
        <div class="grid gap-6 md:grid-cols-3">
          {focusAreas.map((area) => (
            <div class="rounded-2xl bg-card p-6 sm:p-8 border border-border fade-in">
              <area.icon className="size-8 text-accent-ink" strokeWidth={1.5} aria-hidden="true" />
              <h3 class="mt-4 text-xl font-semibold">{area.title}</h3>
              <p class="mt-3 leading-7 text-muted-foreground">{area.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="skills" class="section-space" aria-labelledby="skills-title">
      <div class="site-container">
        <div class="section-heading">
          <h2 id="skills-title" class="section-title fade-in">Keahlian teknis.</h2>
          <p class="fade-in">Teknologi yang sering digunakan dalam proyek nyata.</p>
        </div>
        <div class="space-y-6">
          {skills.map((skill) => (
            <div class="rounded-2xl bg-card p-6 sm:p-8 border border-border fade-in">
              <div class="flex flex-wrap items-baseline justify-between gap-3">
                <h3 class="text-xl font-semibold">{skill.name}</h3>
                <span class="text-sm font-medium text-accent-ink">{skill.level}</span>
              </div>
              <div class="mt-4 flex flex-wrap gap-2">
                {skill.tools.map((tool) => (
                  <span class="rounded-full bg-muted px-3 py-1 text-sm text-muted-foreground">{tool}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
        <a href="/dev/skills" class="text-link mt-8 fade-in">Lihat skills lengkap</a>
      </div>
    </section>

    <section id="approach" class="section-space bg-muted" aria-labelledby="approach-title">
      <div class="site-container">
        <div class="max-w-3xl fade-in">
          <h2 id="approach-title" class="section-title">Cara kerja.</h2>
          <div class="mt-8 space-y-6 text-lg leading-8">
            <p>"Saya percaya produk yang baik lahir dari kolaborasi jujur. Saya akan selalu memberi tahu apa yang mungkin, apa yang tidak, dan mengapa—sebelum kode mulai ditulis."</p>
            <p>Komunikasi langsung, dokumentasi jelas, dan fokus pada hasil yang terukur. Tidak ada jargon berlebihan, tidak ada janji kosong.</p>
          </div>
        </div>
      </div>
    </section>

    <ConsultationCTA
      title="Yuk diskusi proyek Anda."
      description="Dari konsultasi gratis, kita bisa cari tahu apakah Daydev cocok untuk kebutuhan Anda."
      message="Halo Daydev, saya ingin konsultasi langsung dengan founder."
    />
  </main>
</Base>