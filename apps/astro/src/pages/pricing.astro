---
import Base from "../layouts/Base.astro";
import PriceCalculator from "../components/PriceCalculator";
import PricingSection from "../components/sections/PricingSection.astro";
import DataNotice from "../components/DataNotice.astro";
import { getPricing, loadData } from "../lib/api";
import { waLink, WHATSAPP } from "@daydev/shared-types";
import { ChevronDown } from "lucide-react";

const pricing = await loadData(getPricing());
const faqs = [
  { question: "Bagaimana biaya kebutuhan tambahan dihitung?", answer: "Harga dasar mengikuti paket yang Anda pilih. Tuliskan fitur atau integrasi tambahan pada ringkasan estimasi, lalu kami konfirmasi cakupan dan biayanya saat konsultasi." },
  { question: "Berapa banyak revisi yang termasuk?", answer: "Cakupan revisi mengikuti paket yang dipilih dan kesepakatan proyek. Periksa fitur yang tercantum, lalu konfirmasikan kebutuhan revisi sebelum pekerjaan dimulai." },
  { question: "Apakah harga termasuk maintenance dan support?", answer: "Periksa cakupan pada masing-masing paket. Kebutuhan hosting, maintenance, dan dukungan lanjutan dapat dibahas saat konsultasi." },
  { question: "Bagaimana proses pembayaran?", answer: "Pembayaran dapat mengikuti skema down payment dan progress payment. Rincian pembayaran disepakati saat membahas proyek." },
];
---

<Base title="Harga & Paket - Daydev Studio" description="Bandingkan paket layanan Daydev dan susun estimasi berdasarkan kebutuhan proyek Anda." canonicalPath="/pricing">
  <main class="bg-background text-foreground">
    <section class="section-space bg-card">
      <div class="site-container">
        <h1 class="page-title">Harga &amp; paket</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">Bandingkan cakupan layanan, pilih paket sebagai dasar anggaran, lalu bahas kebutuhan proyek Anda bersama kami.</p>
      </div>
    </section>
    {pricing.ok ? <>
      <PricingSection categories={pricing.data} />
      <PriceCalculator client:visible categories={pricing.data} />
    </> : <div class="site-container py-12"><DataNotice title="Daftar harga belum dapat dimuat" /></div>}
    <section class="section-space">
      <div class="site-container grid gap-10 lg:grid-cols-[0.7fr_1.3fr]">
        <h2 class="section-title">Tentang biaya proyek</h2>
        <div class="space-y-3">
          {faqs.map((faq) => <details class="group rounded-2xl bg-muted p-6">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold [&::-webkit-details-marker]:hidden">{faq.question}<ChevronDown className="size-5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" /></summary>
            <p class="mt-4 leading-7 text-muted-foreground">{faq.answer}</p>
          </details>)}
        </div>
      </div>
    </section>
    <section class="section-space bg-muted">
      <div class="site-container flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div><h2 class="section-title">Butuh paket khusus?</h2><p class="mt-4 max-w-xl leading-7 text-muted-foreground">Ceritakan kebutuhan dan anggaran Anda. Kita tentukan cakupan proyek bersama.</p></div>
        <a href={waLink(WHATSAPP.defaultMessage)} target="_blank" rel="noopener noreferrer" class="button-primary shrink-0">Diskusikan via WhatsApp</a>
      </div>
    </section>
  </main>
</Base>
