---
import { SEGMENT_LABELS, waLink, WHATSAPP } from "@daydev/shared-types";
import { ChevronDown } from "lucide-react";

const segments = [
  { id: "startup" as const, title: "MVP dan validasi ide", description: "Mulai dengan fitur yang dibutuhkan untuk menguji ide bisnis. Kembangkan produk melalui iterasi dan masukan pengguna.", features: ["Pengembangan MVP", "Integrasi API dan layanan pihak ketiga", "Dashboard analitik"] },
  { id: "umkm" as const, title: "Operasional bisnis", description: "Hubungkan aktivitas usaha dalam satu sistem, dari penjualan hingga pengelolaan stok dan pesanan.", features: ["Toko online", "Manajemen stok dan laporan keuangan", "Integrasi payment gateway"] },
  { id: "mahasiswa" as const, title: "Sistem dan bimbingan teknis", description: "Diskusikan kebutuhan sistem untuk skripsi atau tugas akhir, beserta pendampingan teknis agar Anda memahami cara kerjanya.", features: ["Pengembangan sistem", "Bimbingan dan konsultasi teknis", "Dokumentasi proyek"] },
];
---

<section id="kebutuhan" class="section-space">
  <div class="site-container grid items-start gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <h2 class="section-title">Mulai dari kebutuhan Anda</h2>
      <p class="mt-5 max-w-md text-lg leading-8">Setiap proyek punya titik awal yang berbeda. Kita tentukan cakupan yang sesuai dengan tujuan Anda.</p>
      <a href="/pricing" class="mt-5 inline-flex min-h-11 items-center font-semibold text-primary">Lihat paket dan harga</a>
    </div>
    <div class="space-y-3">
      {segments.map((segment, index) => (
        <details open={index === 0} class="segment-theme group rounded-2xl bg-[var(--segment-surface)] p-6" data-segment={segment.id}>
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 text-[var(--segment)] [&::-webkit-details-marker]:hidden">
            <h3 class="text-xl font-bold">{SEGMENT_LABELS[segment.id]}</h3>
            <ChevronDown className="size-5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
          </summary>
          <p class="mt-4 font-semibold">{segment.title}</p>
          <p class="mt-3 leading-7">{segment.description}</p>
          <ul class="mt-4 list-disc space-y-2 pl-5 leading-7">{segment.features.map((feature) => <li>{feature}</li>)}</ul>
          <a href={waLink(WHATSAPP.messageSegment(SEGMENT_LABELS[segment.id]))} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex min-h-11 items-center font-semibold text-[var(--segment)] underline underline-offset-4">Bahas kebutuhan {SEGMENT_LABELS[segment.id]}</a>
        </details>
      ))}
    </div>
  </div>
</section>
