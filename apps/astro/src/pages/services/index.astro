---
import Base from "../../layouts/Base.astro";
import ConsultationCTA from "../../components/ConsultationCTA.astro";
import { waLink } from "@daydev/shared-types";
import { services } from "../../lib/services";
import { Check } from "lucide-react";

export const prerender = true;

const comparison = [
  ["Akses", "Melalui browser di berbagai perangkat", "Dipasang melalui App Store atau Play Store"],
  ["Koneksi", "Sebagian besar fungsi menggunakan jaringan", "Fungsi offline dapat disiapkan sesuai kebutuhan"],
  ["Fitur perangkat", "Mengikuti dukungan browser", "Akses notifikasi, biometrik, dan sensor perangkat"],
  ["Pembaruan", "Langsung melalui server", "Mengikuti proses pembaruan aplikasi dan store"],
  ["Kebutuhan", "Konten, toko online, sistem informasi, dan SEO", "Interaksi rutin, fungsi perangkat, dan akses offline"],
];
---

<Base title="Layanan - Daydev Studio" description="Jasa pembuatan website, aplikasi mobile, bot Telegram, dan undangan digital untuk startup, UMKM, dan mahasiswa. Konsultasi gratis via WhatsApp." canonicalPath="/services">
  <main>
    <header class="page-intro">
      <div class="site-container page-intro-grid">
        <h1 class="page-title">Layanan digital.</h1>
        <p>Kebutuhan Anda menjadi titik awal. Dari website pertama hingga aplikasi yang mendukung operasional bisnis.</p>
      </div>
    </header>

    <section class="section-space bg-muted" aria-label="Layanan Daydev">
      <div class="site-container service-catalog">
        {services.map((service) => (
          <article class="service-catalog-row">
            <div>
              <h2 class="section-title fade-in">{service.title}</h2>
              <p class="mt-5 max-w-lg leading-7 fade-in">{service.longDescription}</p>
              <a href={`/services/${service.slug}`} class="text-link mt-5 fade-in">Detail {service.title.toLowerCase()}</a>
            </div>
            <ul class="grid content-start gap-4 rounded-2xl bg-card p-6 sm:p-8 fade-in">
              {service.features.map((feature) => <li class="flex items-start gap-3 leading-7"><Check className="mt-1 size-5 shrink-0 text-accent-ink" aria-hidden="true" />{feature}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="section-space" aria-labelledby="comparison-title">
      <div class="site-container">
        <div class="section-heading">
          <h2 id="comparison-title" class="section-title fade-in">Website atau mobile?</h2>
          <p class="fade-in">Pilih berdasarkan cara pelanggan menggunakan produk Anda dan fitur yang dibutuhkan.</p>
        </div>
        <div class="overflow-x-auto rounded-2xl bg-muted fade-in" tabindex="0" role="region" aria-label="Perbandingan website dan aplikasi mobile">
          <table class="w-full min-w-[36rem] text-left text-sm sm:text-base">
            <caption class="sr-only">Perbedaan website dan aplikasi mobile</caption>
            <thead class="bg-secondary"><tr><th scope="col" class="p-5">Aspek</th><th scope="col" class="p-5">Website</th><th scope="col" class="p-5">Aplikasi mobile</th></tr></thead>
            <tbody>{comparison.map(([aspect, web, mobile]) => <tr class="border-b border-border last:border-0"><th scope="row" class="p-5 align-top font-medium">{aspect}</th><td class="p-5 align-top">{web}</td><td class="p-5 align-top">{mobile}</td></tr>)}</tbody>
          </table>
        </div>
        <a href={waLink("Halo Daydev, saya ingin diskusi apakah bisnis saya butuh website, mobile app, atau keduanya.")} target="_blank" rel="noopener noreferrer" class="text-link mt-6 fade-in">Bahas pilihan untuk bisnis Anda</a>
      </div>
    </section>

    <ConsultationCTA />
  </main>
</Base>
