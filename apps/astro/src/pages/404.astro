---
import Base from "../layouts/Base.astro";
import { ArrowLeft } from "lucide-react";

export const prerender = true;
---

<Base
  title="Halaman Tidak Ditemukan - Daydev Studio"
  description="Halaman yang Anda cari tidak tersedia."
>
  <main class="flex min-h-screen items-center justify-center bg-background px-4 py-24 text-center">
    <div>
      <p class="text-7xl font-bold text-primary">404</p>
      <h1 class="mt-6 text-3xl font-bold text-foreground">
        Halaman tidak ditemukan
      </h1>
      <p class="mt-3 max-w-md text-muted-foreground">
        Halaman yang Anda cari mungkin telah dipindahkan atau tidak tersedia.
        Kembali ke beranda untuk melanjutkan.
      </p>
      <a
        href="/"
        class="mt-8 inline-flex min-h-[48px] items-center gap-2 rounded-full bg-primary px-6 py-3 font-semibold text-white transition-transform hover:scale-[1.02]"
      >
        <ArrowLeft className="size-4" aria-hidden="true" />Kembali ke beranda
      </a>
    </div>
  </main>
</Base>