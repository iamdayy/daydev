# ===== Global env (root .env) =====
# Salin file ini menjadi `.env` di root repo, lalu isi nilainya.
# Semua workspace memakai satu sumber env yang sama (turbo reads globalEnv,
# bun/vite/drizzle membaca .env root lewat symlink di apps/*/.env).

# --- API (apps/api) ---
# WAJIB pooled connection string Neon (endpoint "-pooler"), bukan direct connection
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# set ke "false" kalau memakai postgres lokal non-TLS
DATABASE_SSL=true

JWT_SECRET=generate-a-long-random-string

# Cloudflare R2 (presigned upload)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

SESSION_TTL_MS=604800000

# Kredensial admin yang dibuat saat db:seed (di-skip kalau kosong)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Astro (apps/astro) ---
PUBLIC_API_URL=http://localhost:8000