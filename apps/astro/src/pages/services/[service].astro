---
import Base from "../../layouts/Base.astro";
import { getAllServiceSlugs, getServiceBySlug, services } from "../../lib/services";
import { waLink } from "@daydev/shared-types";
import { ChevronDown } from "lucide-react";
import ConsultationCTA from "../../components/ConsultationCTA.astro";

export const prerender = true;

export function getStaticPaths() {
  return getAllServiceSlugs().map((slug) => ({ params: { service: slug } }));
}

const { service: slug } = Astro.params;
const service = getServiceBySlug(slug!);

if (!service) {
  return Astro.redirect("/404");
}

const related = services.filter((item) => item.slug !== service.slug);
const descriptionParagraphs = service.longDescription.split(/\n\s*\n/).filter((paragraph) => paragraph.trim());

const faqs = [
  {
    question: "Berapa lama waktu pengerjaan?",
    answer: "Waktu pengerjaan mengikuti fitur, integrasi, dan kesiapan konten. Kami menyusun estimasi jadwal setelah cakupan proyek dibahas saat konsultasi awal.",
  },
  {
    question: "Apakah ada paket yang tersedia?",
    answer:
      "Paket yang tersedia dapat dilihat di halaman harga. Kebutuhan di luar cakupan paket bisa dibahas saat konsultasi.",
  },
  {
    question: "Apakah ada dukungan setelah project selesai?",
    answer:
      "Ya, kami menyediakan dukungan teknis dan maintenance setelah project selesai. Detail dukungan bervariasi tergantung paket yang dipilih.",
  },
  {
    question: "Bagaimana proses pembayaran?",
    answer:
      "Kami menerima transfer bank dan e-wallet. Untuk proyek besar, pembayaran mengikuti skema down payment dan progress payment sesuai milestone yang disepakati.",
  },
];
---

<Base
  title={`${service.title} - Daydev Studio`}
  description={service.metaDescription}
  canonicalPath={`/services/${service.slug}`}
>
  <main class="flex min-h-dvh flex-col bg-background text-foreground">
    <header class="page-intro">
      <div class="site-container">
        <nav class="mb-6 flex flex-wrap items-center text-sm text-muted-foreground" aria-label="Breadcrumb">
          <a href="/" class="inline-flex min-h-11 items-center hover:text-foreground">Beranda</a>
          <span class="mx-2" aria-hidden="true">/</span>
          <a href="/services" class="inline-flex min-h-11 items-center hover:text-foreground">Layanan</a>
        </nav>
        <div class="page-intro-grid">
          <h1 class="page-title">{service.title}</h1>
          <div>
            <p class="max-w-lg text-lg leading-8">{service.description}</p>
            <div class="mt-6 flex flex-wrap items-center gap-5">
              <a href={waLink(`Halo Daydev, saya ingin konsultasi tentang ${service.title}.`)} target="_blank" rel="noopener noreferrer" class="button-primary">Konsultasi gratis</a>
              <a href="/pricing" class="text-link">Lihat paket harga</a>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section class:list={["site-container section-space grid gap-10 lg:gap-16", { "lg:grid-cols-[1.5fr_1fr]": service.targetAudience.length > 0 }]}>
      <div class="min-w-0 max-w-2xl">
        <h2 class="section-title fade-in">Tentang layanan</h2>
        <div class="mt-6 space-y-5 text-lg leading-8">{descriptionParagraphs.map((paragraph) => <p class="whitespace-pre-line">{paragraph}</p>)}</div>
      </div>
      {service.targetAudience.length > 0 && <div class="min-w-0 self-start rounded-2xl bg-muted p-6 sm:p-8">
        <h3 class="text-xl font-semibold">Cocok untuk</h3>
        <ul class="mt-4 list-disc space-y-3 pl-5 leading-7">{service.targetAudience.map((audience) => <li>{audience}</li>)}</ul>
      </div>}
    </section>

    {service.benefits.length > 0 && <section class="section-space bg-muted">
      <div class="site-container grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
        <h2 class="section-title fade-in">
          Manfaat layanan
        </h2>
        <ul class="service-points">
          {
            service.benefits.map((benefit) => (
              <li class="leading-7">{benefit}</li>
            ))
          }
        </ul>
      </div>
    </section>}

    {service.features.length > 0 && <section class="site-container section-space grid gap-8 lg:grid-cols-[0.7fr_1.3fr] lg:gap-16">
      <h2 class="section-title fade-in">Fitur utama</h2>
      <ul class="service-points">
        {
          service.features.map((feature) => (
            <li class="leading-7">{feature}</li>
          ))
        }
      </ul>
    </section>}

    <section class="section-space bg-muted">
      <div class="site-container faq-layout">
        <h2 class="section-title fade-in">Tentang pengerjaan</h2>
        <div class="space-y-4">
          {
            faqs.map((faq) => (
              <details class="group rounded-2xl bg-card px-5 sm:px-7 fade-in">
                <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-4 font-semibold [&::-webkit-details-marker]:hidden">
                  {faq.question}
                  <ChevronDown className="size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true" />
                </summary>
                <p class="max-w-3xl pb-6 leading-7">{faq.answer}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section class="site-container section-space">
      <h2 class="text-2xl font-bold tracking-tight text-foreground sm:text-3xl">Layanan lainnya</h2>
      <div class="mt-8 grid gap-x-12 gap-y-8 md:grid-cols-2 xl:grid-cols-3">
        {
          related.map((item) => (
              <a
                href={`/services/${item.slug}`}
                class="group block min-w-0 rounded-lg focus-visible:outline-offset-8"
              >
                <h3 class="text-xl font-semibold group-hover:text-accent-ink">{item.title}</h3>
                <p class="mt-3 leading-7">{item.description}</p>
                <span class="text-link mt-3">Detail layanan</span>
              </a>
          ))
        }
      </div>
    </section>
    <ConsultationCTA message={`Halo Daydev, saya ingin konsultasi tentang ${service.title}.`} />
  </main>
</Base>
