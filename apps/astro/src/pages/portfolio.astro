---
import { PORTFOLIO_CATEGORY_LABELS, waLink } from "@daydev/shared-types";
import { ArrowUpRight } from "lucide-react";
import Base from "../layouts/Base.astro";
import { getPortfolio, loadData } from "../lib/api";
import ProjectImage from "../components/ProjectImage.astro";
import DataNotice from "../components/DataNotice.astro";

const projects = await loadData(getPortfolio());
const published = (projects.data ?? [])
  .filter((project) => project.is_published)
  .sort((a, b) => a.display_order - b.display_order);
---

<Base title="Portofolio - Daydev Studio" description="Lihat proyek Daydev, dari website dan aplikasi mobile hingga bot Telegram dan undangan digital." canonicalPath="/portfolio">
  <main class="bg-background text-foreground">
    <header class="section-space bg-card">
      <div class="site-container">
        <h1 class="page-title">Portofolio Daydev</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-muted-foreground">Lihat tampilan, cakupan pekerjaan, dan teknologi di balik proyek kami. Buka demo untuk mencoba langsung.</p>
      </div>
    </header>
    <div class="site-container section-space space-y-16">
      {!projects.ok ? <DataNotice title="Portofolio belum dapat dimuat" /> : published.length === 0 ? (
        <p class="leading-7 text-muted-foreground">Portofolio sedang disusun. Hubungi kami untuk melihat hasil kerja sebelumnya.</p>
      ) : published.map((project) => (
        <article class:list={["grid items-start gap-8 lg:gap-12", { "md:grid-cols-[1.2fr_1fr]": project.cover_image_url }]}>
          {project.cover_image_url && <ProjectImage src={project.cover_image_url} title={project.title} portrait={project.category === "mobile"} />}
          <div class="min-w-0 max-w-2xl">
            <h2 class="text-2xl font-bold leading-tight tracking-tight sm:text-3xl">{project.title}</h2>
            <p class="mt-3 text-sm text-primary">{PORTFOLIO_CATEGORY_LABELS[project.category]}{project.client_name && ` · ${project.client_name}`}</p>
            <p class="mt-5 leading-7">{project.description}</p>
            {project.result_highlight && <p class="mt-5 rounded-xl bg-muted p-4 font-medium leading-7">{project.result_highlight}</p>}
            {project.tech_stack?.length ? <p class="mt-5 text-sm leading-6 text-muted-foreground">{project.tech_stack.join(" · ")}</p> : null}
            {project.demo_url && <a href={project.demo_url} target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex min-h-11 items-center gap-2 font-semibold text-primary">Buka demo proyek <ArrowUpRight className="size-4" aria-hidden="true" /></a>}
          </div>
        </article>
      ))}
    </div>
    <section class="section-space bg-muted">
      <div class="site-container flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div><h2 class="section-title">Punya proyek serupa?</h2><p class="mt-4 leading-7 text-muted-foreground">Mari bahas kebutuhan dan langkah berikutnya bersama.</p></div>
        <a href={waLink("Halo Daydev, saya ingin diskusi proyek setelah melihat portofolio.")} target="_blank" rel="noopener noreferrer" class="button-primary shrink-0">Diskusikan via WhatsApp</a>
      </div>
    </section>
  </main>
</Base>
