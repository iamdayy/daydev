---
import { waLink, SEGMENT_LABELS, type Segment } from "@daydev/shared-types";
import Base from "../layouts/Base.astro";
import { getPortfolio, loadData } from "../lib/api";
import ProjectCard from "../components/ProjectCard.astro";
import DataNotice from "../components/DataNotice.astro";
import ConsultationCTA from "../components/ConsultationCTA.astro";

const projects = await loadData(getPortfolio());
const allPublished = (projects.data ?? []).filter((project) => project.is_published).sort((a, b) => a.display_order - b.display_order);
const segments: Segment[] = ["umkm", "mahasiswa", "startup", "bot-telegram", "undangan-digital"];
const segmentFilters = [{ value: "all", label: "Semua cerita" }, ...segments.map((segment) => ({ value: segment, label: SEGMENT_LABELS[segment] }))];
---

<Base title="Cerita Pelanggan - Daydev Studio" description="Karya Daydev Studio untuk UMKM, mahasiswa, dan startup. Lihat website dan aplikasi, kebutuhan proyek, serta demo yang tersedia." canonicalPath="/portfolio">
  <main>
    <header class="page-intro">
      <div class="site-container page-intro-grid">
        <h1 class="page-title">Cerita pelanggan.</h1>
        <p>Setiap proyek dimulai dari kebutuhan yang berbeda. Temukan cerita dan karya yang dekat dengan rencana Anda.</p>
      </div>
    </header>

    <section class="section-space bg-muted" aria-label="Portofolio Daydev">
      <div class="site-container">
        {!projects.ok ? <DataNotice title="Cerita pelanggan belum dapat dimuat" /> : allPublished.length === 0 ? (
          <div class="max-w-xl">
            <h2 class="text-2xl font-semibold">Belum ada cerita yang diterbitkan</h2>
            <p class="mt-4 leading-7 text-muted-foreground">Hubungi studio untuk melihat contoh proyek yang sesuai dengan kebutuhan Anda.</p>
            <a href={waLink("Halo Daydev, saya ingin melihat portofolio untuk kebutuhan proyek saya.")} target="_blank" rel="noopener noreferrer" class="text-link mt-4">Tanyakan portofolio</a>
          </div>
        ) : (
          <>
            <div id="segment-filter" class="mb-10 flex flex-wrap items-center gap-2" role="group" aria-label="Filter segmen pelanggan" hidden>
              {segmentFilters.map((filter) => <button type="button" data-segment={filter.value} class="segment-filter-btn" aria-controls="stories-grid" aria-pressed={filter.value === "all"}>{filter.label}</button>)}
            </div>
            <p id="filter-count" class="sr-only" role="status" aria-live="polite"></p>
            <div id="stories-grid" class="projects-grid">
              {allPublished.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
            </div>
            <div id="no-results" class="rounded-2xl bg-card p-6 sm:p-10" hidden>
              <h2 class="text-2xl font-semibold">Belum ada cerita di segmen ini</h2>
              <p class="mt-3 leading-7 text-muted-foreground">Pilih segmen lain untuk melihat proyek yang tersedia.</p>
              <button type="button" id="reset-filter" class="button-secondary mt-6">Tampilkan semua cerita</button>
            </div>
          </>
        )}
      </div>
    </section>

    <ConsultationCTA title="Punya kebutuhan serupa?" message="Halo Daydev, saya ingin diskusi proyek setelah membaca cerita pelanggan." />
  </main>
</Base>

<script>
  const filter = document.getElementById("segment-filter");
  const buttons = document.querySelectorAll<HTMLButtonElement>(".segment-filter-btn");
  const cards = document.querySelectorAll<HTMLElement>("#stories-grid .story-card");
  const noResults = document.getElementById("no-results");
  const count = document.getElementById("filter-count");
  if (filter) filter.hidden = false;

  function filterStories(segment: string) {
    let visible = 0;
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.segment === segment)));
    cards.forEach((card) => {
      const matches = segment === "all" || card.dataset.segment === segment;
      card.hidden = !matches;
      card.classList.toggle("project-featured", matches && visible === 0);
      if (matches) {
        card.classList.remove("reveal-pending");
        visible++;
      }
    });
    if (noResults) noResults.hidden = visible > 0;
    if (count) count.textContent = `${visible} cerita ditampilkan.`;
  }

  buttons.forEach((button, index) => {
    button.addEventListener("click", () => filterStories(button.dataset.segment ?? "all"));
    button.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") return;
      event.preventDefault();
      const direction = event.key === "ArrowRight" ? 1 : -1;
      buttons[(index + direction + buttons.length) % buttons.length]?.focus();
    });
  });
  document.getElementById("reset-filter")?.addEventListener("click", () => {
    filterStories("all");
    buttons[0]?.focus();
  });
</script>
