---
import type { SiteStat } from "@daydev/shared-types";

interface Props {
  stats: SiteStat[];
}

const stats = Astro.props.stats.filter((stat) => stat.value.trim());

const statLabels: Record<string, string> = {
  "topik-konsultasi": "Topik konsultasi",
  "proyek-selesai": "Proyek selesai",
  "klien-bisnis": "Klien bisnis",
  "rating-klien": "Rating klien",
  review: "Review positif",
  total_proyek: "Total proyek",
  klien: "Klien yang terbantu",
  tahun_pengalaman: "Tahun pengalaman",
};

---

{
  stats.length > 0 && (
    <section id="statistik" class="bg-foreground py-12 text-white">
      <div class="site-container">
        <h2 class="mb-8 text-2xl font-semibold tracking-tight">Daydev dalam angka</h2>
        <dl class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,10rem),1fr))] gap-8">
          {
            stats.map((stat) => (
              <div class="min-w-0">
                <dt class="text-sm text-slate-300">{statLabels[stat.key] ?? stat.key.replace(/[-_]/g, " ")}</dt>
                <dd class="mt-2 break-words text-3xl font-bold tracking-tight tabular-nums sm:text-4xl">
                  {stat.value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>
  )
}
