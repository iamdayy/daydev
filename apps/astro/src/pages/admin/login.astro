---
import LoginForm from "../../components/admin/LoginForm";
import "../../styles/global.css";

export const prerender = false;

const pathname = Astro.url.pathname;
const redirectTo = new URL(pathname, Astro.url).searchParams.get("next") ?? "/admin";
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Login - Admin Daydev</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
  </head>
  <body class="flex min-h-screen items-center justify-center bg-[#172033] text-foreground px-4">
    <div class="w-full max-w-md rounded-3xl border border-white/10 bg-white p-8 shadow-2xl sm:p-10">
      <div class="mb-8 text-center">
        <a href="/" class="text-3xl font-bold tracking-tight text-[#172033]">
          Daydev <span class="text-[#ea7b3c]">Studio</span>
        </a>
        <p class="mt-2 text-sm text-muted-foreground">
          Panel admin — masuk untuk mengelola konten.
        </p>
      </div>
      <LoginForm client:load redirectTo={redirectTo} />
    </div>
  </body>
</html>