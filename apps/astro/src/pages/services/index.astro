---
import Base from "../../layouts/Base.astro";
import { waLink } from "@daydev/shared-types";
import { comparison, services } from "../../lib/services";

export const prerender = true;
---

<Base title="Layanan - Daydev Studio" description="Jasa pengembangan website, aplikasi mobile, bot Telegram, dan undangan digital untuk startup, UMKM, dan mahasiswa." canonicalPath="/services">
  <main>
    <header class="section-space bg-card">
      <div class="site-container">
        <h1 class="page-title">Layanan Daydev</h1>
        <p class="mt-6 max-w-2xl text-lg leading-8">Kami membantu startup, UMKM, dan mahasiswa membangun website, aplikasi mobile, bot Telegram, hingga undangan digital.</p>
      </div>
    </header>

    <div class="site-container section-space space-y-14 sm:space-y-16">
      {services.map((service) => (
        <article class="grid gap-6 md:grid-cols-[0.85fr_1.15fr] md:gap-12 lg:gap-20">
          <div class="min-w-0">
            <h2 class="text-2xl font-bold leading-tight tracking-tight lg:text-3xl"><a href={`/services/${service.slug}`} class="hover:text-primary">{service.title}</a></h2>
            {service.targetAudience.length > 0 && <p class="mt-4 max-w-sm text-sm leading-6 text-muted-foreground">Untuk {service.targetAudience.join(", ")}</p>}
          </div>
          <div class="min-w-0 max-w-2xl">
            <p class="whitespace-pre-line text-lg leading-8">{service.description}</p>
            {service.benefits.length > 0 && <ul class="mt-5 list-disc space-y-2 pl-5 leading-7">
              {service.benefits.slice(0, 3).map((benefit) => <li>{benefit}</li>)}
            </ul>}
            <a href={`/services/${service.slug}`} class="text-link mt-4">Detail layanan</a>
          </div>
        </article>
      ))}
    </div>

    <section class="section-space bg-muted">
      <div class="site-container">
        <h2 id="perbandingan-layanan" class="section-title">Bandingkan layanan</h2>
        <p class="mt-5 leading-7">Perkiraan waktu menyesuaikan cakupan proyek yang disepakati saat konsultasi.</p>
        <div class="mt-8 overflow-x-auto rounded-2xl bg-card" role="region" aria-labelledby="perbandingan-layanan" tabindex="0">
          <table class="w-full text-left text-sm">
            <thead><tr class="border-b border-border"><th scope="col" class="px-4 py-5 sm:px-6">Layanan</th><th scope="col" class="px-4 py-5 sm:px-6">Waktu</th><th scope="col" class="px-4 py-5 sm:px-6">Kompleksitas</th></tr></thead>
            <tbody>{comparison.map((row) => (
              <tr class="border-b border-border last:border-0"><th scope="row" class="px-4 py-5 font-semibold sm:px-6">{row.name}</th><td class="px-4 py-5 sm:px-6">{row.timeline}</td><td class="px-4 py-5 sm:px-6">{row.complexity}</td></tr>
            ))}</tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="section-space bg-primary text-white">
      <div class="site-container flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
        <div><h2 class="section-title">Mulai dari kebutuhan Anda</h2><p class="mt-5 max-w-xl leading-7">Ceritakan tujuan proyek Anda. Kita tentukan layanan dan langkah awalnya bersama.</p></div>
        <a href={waLink("Halo Daydev, saya ingin konsultasi gratis mengenai pengembangan aplikasi.")} target="_blank" rel="noopener noreferrer" class="button-primary shrink-0">Konsultasi via WhatsApp</a>
      </div>
    </section>
  </main>
</Base>
