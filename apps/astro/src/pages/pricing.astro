---
import Base from "../layouts/Base.astro";
import ConsultationCTA from "../components/ConsultationCTA.astro";
import PricingSection from "../components/sections/PricingSection.astro";
import PriceCalculator from "../components/PriceCalculator";
import DataNotice from "../components/DataNotice.astro";
import { getPricing, loadData } from "../lib/api";
import { ChevronDown } from "lucide-react";


const pricing = await loadData(getPricing());

const faqs = [
  {
    question: "Bagaimana biaya kebutuhan tambahan dihitung?",
    answer: "Harga dasar mengikuti paket yang Anda pilih. Tulis fitur atau integrasi tambahan pada ringkasan estimasi, lalu kami konfirmasi cakupan dan biayanya saat konsultasi."
  },
  {
    question: "Berapa banyak revisi yang termasuk?",
    answer: "Cakupan revisi mengikuti paket yang dipilih dan kesepakatan proyek. Periksa fitur yang tercantum, lalu konfirmasikan kebutuhan revisi sebelum pekerjaan dimulai."
  },
  {
    question: "Bagaimana proses pembayaran?",
    answer: "Pembayaran mengikuti skema down payment (DP) dan progress payment. DP umumnya 30–50% saat kontrak, sisanya dibagi per milestone yang disepakati. Kami terima transfer bank dan e-wallet."
  },
];
---

<Base title="Harga & Paket - Daydev Studio" description="Bandingkan paket layanan Daydev untuk UMKM, Mahasiswa, dan Startup. Susun estimasi berdasarkan kebutuhan proyek Anda. Konsultasi gratis via WhatsApp." canonicalPath="/pricing">
  <main>
    <header class="page-intro">
      <div class="site-container page-intro-grid">
        <h1 class="page-title">Harga & paket.</h1>
        <p>Paket di bawah adalah titik awal diskusi, bukan harga final. Cakupan, integrasi, jadwal, dan kebutuhan khusus dikonfirmasi bersama sebelum proyek dimulai.</p>
      </div>
    </header>

    <section class="section-space bg-muted" aria-label="Daftar paket layanan">
      <div class="site-container">
        {pricing.ok ? (
          <div>
            <PricingSection categories={pricing.data} segmentOrder={["umkm", "mahasiswa", "startup", "bot-telegram", "undangan-digital"]} />
            <PriceCalculator client:load categories={pricing.data} />
          </div>
        ) : (
          <div class="max-w-xl"><DataNotice title="Daftar harga belum dapat dimuat" /></div>
        )}
      </div>
    </section>

    <section class="section-space" aria-labelledby="payment-faq-title">
      <div class="site-container faq-layout">
        <h2 id="payment-faq-title" class="section-title fade-in">Tentang pembayaran</h2>
        <div class="space-y-4">
          {faqs.map((faq) => (
            <details class="group rounded-2xl bg-card p-6 sm:p-8 fade-in">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-semibold text-foreground [&::-webkit-details-marker]:hidden">
                {faq.question}
                <ChevronDown className="size-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true" />
              </summary>
              <p class="mt-4 leading-7 text-muted-foreground">{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <ConsultationCTA title="Belum yakin paket mana yang cocok?" message="Halo Daydev, saya ingin diskusikan paket yang cocok untuk proyek saya." />
  </main>
</Base>
