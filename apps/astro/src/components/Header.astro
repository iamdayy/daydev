---
const navLinks = [
  { label: "Beranda", href: "/" },
  { label: "Layanan", href: "/services" },
  { label: "Harga", href: "/pricing" },
  { label: "Portofolio", href: "/portfolio" },
  { label: "Blog", href: "/blog" },
];

const pathname = Astro.url.pathname;
const waLink = "https://wa.me/6285175284253";
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 bg-foreground text-white">
  <div class="site-container flex h-[var(--site-header-height)] items-center justify-between">
    <a href="/" class="flex min-h-11 items-center gap-2 group" aria-label="Daydev Studio - Beranda">
      <div class="w-9 h-9 bg-white rounded-lg flex items-center justify-center font-bold text-[#172033] text-lg group-hover:scale-110 transition-transform overflow-hidden">
        <img src="/logo.png" alt="Daydev Logo" width="20" height="20" class="object-contain" />
      </div>
      <span class="text-white font-bold text-xl tracking-tight">
        day<span class="text-[#ea7b3c]">dev</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8" aria-label="Navigasi utama">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
               "inline-flex min-h-11 items-center transition-colors font-medium text-sm",
               isActive(link.href)
                ? "text-[#ea7b3c]"
                : "text-gray-300 hover:text-[#ea7b3c]",
            ]}
            aria-current={isActive(link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={waLink}
        target="_blank"
        rel="noopener noreferrer"
        class="button-primary text-sm"
      >
        Konsultasi Gratis
      </a>
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden text-white p-2 min-h-[44px] min-w-[44px] flex items-center justify-center"
      aria-label="Buka menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" data-icon="open">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true" data-icon="close">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width={2} d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <nav id="mobile-menu" aria-label="Navigasi mobile" class="md:hidden bg-foreground px-4 pb-4 hidden max-h-[calc(100dvh-var(--site-header-height))] overflow-y-auto" hidden>
    {
      navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "block py-3 min-h-[44px] flex items-center transition-colors font-medium border-b border-white/5",
            isActive(link.href) ? "text-[#ea7b3c]" : "text-gray-300 hover:text-[#ea7b3c]",
          ]}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))
    }
    <a
      href={waLink}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 flex min-h-[48px] items-center justify-center bg-[#ea7b3c] text-[#172033] px-5 py-3 rounded-full font-semibold text-center hover:brightness-110 transition-all"
    >
      Konsultasi Gratis
    </a>
  </nav>
</header>

<script>
  const header = document.getElementById("site-header") as HTMLElement | null;
  const toggle = document.getElementById("menu-toggle") as HTMLButtonElement | null;
  const menu = document.getElementById("mobile-menu") as HTMLElement | null;
  const openIcon = toggle?.querySelector('[data-icon="open"]');
  const closeIcon = toggle?.querySelector('[data-icon="close"]');

  const onScroll = () => {
    if (!header) return;
    const scrolled = window.scrollY > 20;
    header.classList.toggle("shadow-lg", scrolled);
  };
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  const setOpen = (openState: boolean) => {
    if (!menu || !toggle) return;
    menu.hidden = !openState;
    menu.classList.toggle("hidden", !openState);
    toggle.setAttribute("aria-expanded", String(openState));
    toggle.setAttribute("aria-label", openState ? "Tutup menu" : "Buka menu");
    openIcon?.classList.toggle("hidden", openState);
    closeIcon?.classList.toggle("hidden", !openState);
  };

  toggle?.addEventListener("click", () => setOpen(menu?.hidden === true));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) {
      setOpen(false);
      toggle?.focus();
    }
  });
  menu?.addEventListener("click", (e) => {
    if (e.target instanceof Element && e.target.closest("a")) setOpen(false);
  });
  header?.addEventListener("focusout", (e) => {
    if (e.relatedTarget instanceof Node && !header.contains(e.relatedTarget)) setOpen(false);
  });
  document.addEventListener("pointerdown", (e) => {
    if (e.target instanceof Node && !header?.contains(e.target)) setOpen(false);
  });
  window.matchMedia("(min-width: 768px)").addEventListener("change", () => setOpen(false));
</script>
